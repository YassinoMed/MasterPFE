{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "SecureRAG Hub — DevSecOps Overview Dashboard",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "title": "SecureRAG Hub — DevSecOps Overview",
  "uid": "securerag-devsecops-overview",
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "AI Global Risk Score",
      "type": "gauge",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "ai_security_risk_score{namespace=\"securerag-hub\"}",
          "legendFormat": "{{ service }}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 25 },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 75 }
            ]
          },
          "min": 0,
          "max": 100,
          "unit": "none"
        }
      }
    },
    {
      "id": 2,
      "title": "AI Consensus Score",
      "type": "gauge",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "ai_consensus_score{namespace=\"securerag-hub\"}",
          "legendFormat": "{{ service }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "yellow", "value": 70 },
              { "color": "green", "value": 90 }
            ]
          },
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 3,
      "title": "AI Decisions (Pass/Warn/Block)",
      "type": "piechart",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (decision) (ai_decisions_total)",
          "legendFormat": "{{ decision }}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Runtime Security Events",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(ai_runtime_events_total[24h]))",
          "legendFormat": "Events (24h)"
        }
      ]
    },
    {
      "id": 5,
      "title": "Risk Score Over Time",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "ai_security_risk_score{namespace=\"securerag-hub\"}",
          "legendFormat": "{{ service }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "pointSize": 5
          },
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 6,
      "title": "Risk Calculations Rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum by (result) (rate(ai_risk_calculations_total[5m]))",
          "legendFormat": "{{ result }}"
        }
      ]
    },
    {
      "id": 7,
      "title": "HTTP Error Rate (5xx)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum by (handler) (rate(http_request_duration_seconds_count{namespace=\"securerag-hub\",status=~\"5..\"}[5m]))",
          "legendFormat": "{{ handler }}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Pod Status",
      "type": "table",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "kube_pod_status_ready{namespace=\"securerag-hub\"}",
          "format": "table",
          "legendFormat": ""
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(kube_pod_info, namespace)",
        "current": { "text": "securerag-hub", "value": "securerag-hub" },
        "includeAll": false,
        "multi": false
      }
    ]
  }
}
