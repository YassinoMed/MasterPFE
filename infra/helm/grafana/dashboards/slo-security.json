      "title": "Vault Authentication Latency (99th Percentile)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(vault_core_handle_request_duration_seconds_bucket{path=\"auth/kubernetes/login\"}[5m])) by (le))",
