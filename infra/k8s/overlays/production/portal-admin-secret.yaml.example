# Secret production créé via SOPS ou ExternalSecrets.
# Fichier prêt comme gabarit si besoin d'un secret en clair du pile pour les tests locaux.
# Ne jamais committer de vraie valeur ici.
#
# Génération recommandée en production :
#   kubectl create secret generic portal-admin-token \
#     --from-literal=token="$(head -c 32 /dev/urandom | base64 | tr -d '/+=' | cut -c1-48)" \
#     -n securerag-hub
#
# Ou via External Secrets Operator synchronisé depuis Vault.
apiVersion: v1
kind: Secret
metadata:
  name: portal-admin-token
  namespace: securerag-hub
  labels:
    app.kubernetes.io/part-of: securerag-hub
stringData:
  token: prod-admin-token-not-downloaded
