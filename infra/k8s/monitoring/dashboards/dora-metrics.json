{
  "title": "SecureRAG DORA Metrics",
  "uid": "dora-metrics",
  "tags": ["securerag", "dora", "devops"],
  "timezone": "browser",
  "refresh": "5m",
  "panels": [
    {
      "id": 1,
      "title": "Deployment Frequency (24h)",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "sum(increase(argocd_app_sync_total[24h]))"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 5}, {"color": "green", "value": 20}]}}}
    },
    {
      "id": 2,
      "title": "Lead Time for Changes",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "avg(argocd_app_sync_duration_seconds)"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "red", "value": 3600}, {"color": "yellow", "value": 600}, {"color": "green", "value": 60}]}}}
    },
    {
      "id": 3,
      "title": "Change Failure Rate",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "(count(argocd_app_health{health=~\"Degraded|Missing\"}) / count(argocd_app_health)) * 100"}],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 15}, {"color": "red", "value": 30}]}}}
    },
    {
      "id": 4,
      "title": "MTTR (System Recovery)",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "sum(kube_pod_status_ready{condition=\"true\"}) / sum(kube_pod_status_phase{phase=\"Running\"}) * 100"}],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"steps": [{"color": "red", "value": 80}, {"color": "yellow", "value": 95}, {"color": "green", "value": 99}]}}}
    },
    {
      "id": 5,
      "title": "ArgoCD Sync History",
      "type": "timeseries",
      "gridPos": {"h": 12, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "increase(argocd_app_sync_total[1h])", "legendFormat": "{{app}}"}]
    },
    {
      "id": 6,
      "title": "Application Health Timeline",
      "type": "timeseries",
      "gridPos": {"h": 12, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "argocd_app_health", "legendFormat": "{{app}} {{health}}"}]
    }
  ]
}
