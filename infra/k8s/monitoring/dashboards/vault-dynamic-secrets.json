apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-dashboard-vault-dynamic-secrets
  namespace: securerag-monitoring
  labels:
    grafana_dashboard: "1"
    app.kubernetes.io/category: security
    app.kubernetes.io/part-of: securerag-hub
data:
  vault-dynamic-secrets.json: |
    {
      "title": "SecureRAG - Vault Dynamic Secrets",
      "uid": "securerag-vault-dynamic",
      "schemaVersion": 39,
      "version": 1,
      "refresh": "30s",
      "tags": ["securerag", "vault", "dynamic-secrets", "security"],
      "time": { "from": "now-6h", "to": "now" },
      "templating": {
        "list": [
          { "name": "engine", "type": "query", "datasource": "Prometheus", "query": "label_values(vault_dynamic_lease_count, secret_engine)", "includeAll": true, "multi": true }
        ]
      },
      "panels": [
        {
          "id": 1, "type": "stat",
          "title": "Active Leases",
          "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
          "targets": [{
            "expr": "sum(vault_dynamic_lease_count{secret_engine=~\"$engine\"})",
            "legendFormat": "leases",
            "refId": "A"
          }],
          "fieldConfig": {
            "defaults": {
              "unit": "none",
              "color": { "mode": "fixed", "fixedColor": "purple" }
            }
          }
        },
        {
          "id": 2, "type": "stat",
          "title": "Secret Engine Health",
          "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
          "targets": [{
            "expr": "avg(vault_secret_engine_health{secret_engine=~\"$engine\"})",
            "legendFormat": "health",
            "refId": "A"
          }],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "min": 0,
              "max": 100,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "red", "value": null },
                  { "color": "orange", "value": 80 },
                  { "color": "green", "value": 95 }
                ]
              }
            }
          }
        },
        {
          "id": 3, "type": "stat",
          "title": "Credential Rotation Rate",
          "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
          "targets": [{
            "expr": "sum(rate(vault_credential_rotation_total[5m]))",
            "legendFormat": "rotations/s",
            "refId": "A"
          }],
          "fieldConfig": { "defaults": { "unit": "rps" } }
        },
        {
          "id": 4, "type": "stat",
          "title": "Lease TTL (avg)",
          "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
          "targets": [{
            "expr": "avg(vault_lease_ttl_seconds{secret_engine=~\"$engine\"})",
            "legendFormat": "avg TTL",
            "refId": "A"
          }],
          "fieldConfig": { "defaults": { "unit": "s" } }
        },
        {
          "id": 5, "type": "histogram",
          "title": "Lease TTL Distribution",
          "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
          "targets": [{
            "expr": "sum(rate(vault_lease_ttl_seconds_bucket[5m])) by (le)",
            "legendFormat": "{{le}}",
            "refId": "A"
          }],
          "fieldConfig": { "defaults": { "unit": "s" } }
        },
        {
          "id": 6, "type": "timeseries",
          "title": "Credential Rotation Events",
          "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
          "targets": [{
            "expr": "sum(rate(vault_credential_rotation_total[5m])) by (secret_engine)",
            "legendFormat": "{{secret_engine}}",
            "refId": "A"
          }],
          "fieldConfig": { "defaults": { "unit": "eps" } }
        },
        {
          "id": 7, "type": "timeseries",
          "title": "Lease Count by Engine",
          "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
          "targets": [{
            "expr": "vault_dynamic_lease_count{secret_engine=~\"$engine\"}",
            "legendFormat": "{{secret_engine}}",
            "refId": "A"
          }],
          "fieldConfig": { "defaults": { "unit": "none" } }
        },
        {
          "id": 8, "type": "table",
          "title": "Lease Expiry Countdown",
          "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
          "targets": [{
            "expr": "vault_lease_expiry_timestamp{secret_engine=~\"$engine\"}",
            "legendFormat": "{{lease_id}}",
            "refId": "A",
            "format": "table",
            "instant": true
          }],
          "transformations": [
            { "id": "organize", "options": { "renameByName": { "Value": "Expiry" } } }
          ]
        }
      ]
    }
