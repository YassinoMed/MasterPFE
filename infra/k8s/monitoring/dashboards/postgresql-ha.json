{
  "title": "SecureRAG Hub — PostgreSQL HA",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "tags": ["securerag", "postgresql", "ha"],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Primary Pod",
      "targets": [{ "expr": "cnpg_current_primary == 1", "datasource": "Prometheus" }],
      "gridPos": { "x": 0, "y": 0, "w": 3, "h": 3 },
      "fieldConfig": { "defaults": { "mappings": [{ "options": { "1": { "text": "Active" } } }] } }
    },
    {
      "id": 2, "type": "stat", "title": "Replication Lag",
      "targets": [{ "expr": "cnpg_replication_lag_bytes", "datasource": "Prometheus" }],
      "gridPos": { "x": 3, "y": 0, "w": 3, "h": 3 }
    },
    {
      "id": 3, "type": "stat", "title": "Active Connections",
      "targets": [{ "expr": "cnpg_backends_total", "datasource": "Prometheus" }],
      "gridPos": { "x": 6, "y": 0, "w": 3, "h": 3 }
    },
    {
      "id": 4, "type": "stat", "title": "Transactions/s",
      "targets": [{ "expr": "rate(cnpg_xact_commit_total[1m])", "datasource": "Prometheus" }],
      "gridPos": { "x": 9, "y": 0, "w": 3, "h": 3 }
    },
    {
      "id": 10, "type": "timeseries", "title": "Connections over Time",
      "targets": [
        { "expr": "cnpg_backends_total", "legendFormat": "Connections", "datasource": "Prometheus" }
      ],
      "gridPos": { "x": 0, "y": 3, "w": 12, "h": 8 }
    },
    {
      "id": 11, "type": "timeseries", "title": "Replication Lag over Time",
      "targets": [
        { "expr": "cnpg_replication_lag_bytes", "legendFormat": "Lag (bytes)", "datasource": "Prometheus" }
      ],
      "gridPos": { "x": 12, "y": 3, "w": 12, "h": 8 }
    }
  ]
}
