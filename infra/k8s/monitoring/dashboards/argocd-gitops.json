{
  "title": "SecureRAG Hub — ArgoCD GitOps",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["securerag", "argocd", "gitops"],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Applications Synced",
      "targets": [{ "expr": "count(argocd_app_info{sync_status=\"Synced\"})" }],
      "gridPos": { "x": 0, "y": 0, "w": 3, "h": 3 },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "green" } } }
    },
    {
      "id": 2, "type": "stat", "title": "Applications OutOfSync",
      "targets": [{ "expr": "count(argocd_app_info{sync_status=\"OutOfSync\"})" }],
      "gridPos": { "x": 3, "y": 0, "w": 3, "h": 3 },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "orange" } } }
    },
    {
      "id": 3, "type": "stat", "title": "Healthy",
      "targets": [{ "expr": "count(argocd_app_info{health_status=\"Healthy\"})" }],
      "gridPos": { "x": 6, "y": 0, "w": 3, "h": 3 },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "green" } } }
    },
    {
      "id": 4, "type": "stat", "title": "Degraded",
      "targets": [{ "expr": "count(argocd_app_info{health_status=\"Degraded\"})" }],
      "gridPos": { "x": 9, "y": 0, "w": 3, "h": 3 },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "red" } } }
    },
    {
      "id": 10, "type": "table", "title": "Application Status",
      "targets": [
        { "expr": "argocd_app_info", "format": "table" }
      ],
      "gridPos": { "x": 0, "y": 3, "w": 24, "h": 12 }
    }
  ]
}
