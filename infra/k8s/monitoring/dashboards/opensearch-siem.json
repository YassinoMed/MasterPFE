apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-dashboard-opensearch-siem
  namespace: securerag-monitoring
  labels:
    grafana_dashboard: "1"
    app.kubernetes.io/category: security
    app.kubernetes.io/part-of: securerag-hub
data:
  opensearch-siem.json: |
    {
      "title": "SecureRAG - OpenSearch SIEM",
      "uid": "securerag-opensearch-siem",
      "schemaVersion": 39,
      "version": 1,
      "refresh": "30s",
      "tags": ["securerag", "opensearch", "siem", "security"],
      "time": { "from": "now-24h", "to": "now" },
      "panels": [
        {
          "id": 1, "type": "stat",
          "title": "Total Security Events (24h)",
          "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
          "targets": [{
            "expr": "sum(increase(opensearch_security_events_total[24h]))",
            "legendFormat": "events",
            "refId": "A"
          }],
          "fieldConfig": {
            "defaults": {
              "unit": "none",
              "color": { "mode": "fixed", "fixedColor": "red" }
            }
          }
        },
        {
          "id": 2, "type": "stat",
          "title": "Critical Alerts (24h)",
          "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
          "targets": [{
            "expr": "sum(increase(opensearch_security_events_total{severity=\"critical\"}[24h]))",
            "legendFormat": "critical",
            "refId": "A"
          }],
          "fieldConfig": {
            "defaults": {
              "unit": "none",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "orange", "value": 5 },
                  { "color": "red", "value": 20 }
                ]
              }
            }
          }
        },
        {
          "id": 3, "type": "stat",
          "title": "Events per Second (avg)",
          "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
          "targets": [{
            "expr": "avg(rate(opensearch_security_events_total[5m]))",
            "legendFormat": "eps",
            "refId": "A"
          }],
          "fieldConfig": { "defaults": { "unit": "eps" } }
        },
        {
          "id": 4, "type": "stat",
          "title": "Active Alerts",
          "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
          "targets": [{
            "expr": "sum(opensearch_active_alerts)",
            "legendFormat": "alerts",
            "refId": "A"
          }],
          "fieldConfig": {
            "defaults": {
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "orange", "value": 3 },
                  { "color": "red", "value": 10 }
                ]
              }
            }
          }
        },
        {
          "id": 5, "type": "piechart",
          "title": "Events by Source",
          "gridPos": { "x": 0, "y": 4, "w": 8, "h": 8 },
          "targets": [{
            "expr": "sum(rate(opensearch_security_events_total[5m])) by (source)",
            "legendFormat": "{{source}}",
            "refId": "A"
          }],
          "options": {
            "displayLabels": ["name", "percent"],
            "legend": { "displayMode": "list", "placement": "right" },
            "pieType": "pie",
            "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }
          }
        },
        {
          "id": 6, "type": "timeseries",
          "title": "Events Over Time",
          "gridPos": { "x": 8, "y": 4, "w": 16, "h": 8 },
          "targets": [{
            "expr": "sum(rate(opensearch_security_events_total[5m])) by (source)",
            "legendFormat": "{{source}}",
            "refId": "A"
          }],
          "fieldConfig": { "defaults": { "unit": "eps" } }
        },
        {
          "id": 7, "type": "table",
          "title": "Top Security Signatures",
          "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
          "targets": [{
            "expr": "topk(20, sum(rate(opensearch_security_events_total[24h])) by (signature_id, signature_name))",
            "legendFormat": "{{signature_id}} - {{signature_name}}",
            "refId": "A",
            "format": "table",
            "instant": true
          }],
          "transformations": [
            { "id": "organize", "options": { "renameByName": { "Value": "Rate" } } }
          ]
        },
        {
          "id": 8, "type": "heatmap",
          "title": "MITRE ATT&CK Heatmap",
          "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
          "targets": [{
            "expr": "sum(rate(opensearch_mitre_attack_events_total[24h])) by (tactic, technique)",
            "legendFormat": "{{tactic}} - {{technique}}",
            "refId": "A",
            "format": "table",
            "instant": true
          }],
          "transformations": [
            { "id": "organize", "options": { "renameByName": { "Value": "Count" } } }
          ]
        }
      ]
    }
