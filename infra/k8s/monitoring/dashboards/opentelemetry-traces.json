{
  "title": "SecureRAG Hub — OpenTelemetry Traces",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": ["securerag", "otel", "traces"],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Spans/min",
      "targets": [{ "expr": "rate(traces_spans_received_total[1m]) * 60", "datasource": "Prometheus" }],
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 }
    },
    {
      "id": 2, "type": "stat", "title": "Error Spans/min",
      "targets": [{ "expr": "rate(traces_spans_received_total{status=\"error\"}[1m]) * 60", "datasource": "Prometheus" }],
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "red" } } }
    },
    {
      "id": 3, "type": "stat", "title": "Avg Latency",
      "targets": [{ "expr": "histogram_quantile(0.50, rate(traces_span_duration_seconds_bucket[5m]))", "datasource": "Prometheus" }],
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 }
    },
    {
      "id": 10, "type": "timeseries", "title": "Spans by Service",
      "targets": [
        { "expr": "sum(rate(traces_spans_received_total[5m])) by (service_name)", "legendFormat": "{{service_name}}", "datasource": "Prometheus" }
      ],
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 }
    },
    {
      "id": 11, "type": "timeseries", "title": "p50/p95/p99 Latency",
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(traces_span_duration_seconds_bucket[5m]))", "legendFormat": "p50", "datasource": "Prometheus" },
        { "expr": "histogram_quantile(0.95, rate(traces_span_duration_seconds_bucket[5m]))", "legendFormat": "p95", "datasource": "Prometheus" },
        { "expr": "histogram_quantile(0.99, rate(traces_span_duration_seconds_bucket[5m]))", "legendFormat": "p99", "datasource": "Prometheus" }
      ],
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 }
    }
  ]
}
