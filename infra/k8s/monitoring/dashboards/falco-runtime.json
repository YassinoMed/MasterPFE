{
  "dashboard": {
    "title": "Falco Runtime Security",
    "description": "Runtime security events, Falco alerts, MITRE ATT&CK mapping",
    "panels": [
      { "title": "CRITICAL Alerts", "type": "stat", "datasource": "prometheus", "targets": [{ "expr": "falco_events{priority=\"CRITICAL\"}", "legendFormat": "CRITICAL" }] },
      { "title": "Alert Rate (1h)", "type": "timeseries", "datasource": "prometheus", "targets": [{ "expr": "rate(falco_events_total[1h])", "legendFormat": "Events/hour" }] },
      { "title": "Top Rules Triggered", "type": "barchart", "datasource": "prometheus", "targets": [{ "expr": "topk(5, falco_events)", "legendFormat": "{{rule}}" }] },
      { "title": "MITRE Tactics", "type": "piechart", "datasource": "prometheus", "targets": [{ "expr": "falco_events", "legendFormat": "{{mitre_tactic}}" }] }
    ],
    "tags": ["securerag-hub", "falco", "runtime", "security"],
    "schemaVersion": 36
  }
}
