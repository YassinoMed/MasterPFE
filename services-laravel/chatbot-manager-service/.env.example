# SecureRAG Hub — variables d'environnement (template)
#
# Copier en .env (jamais commité) puis adapter.
# AUCUNE valeur réelle de production ne doit apparaître dans ce fichier.
# Pour la production, utiliser SOPS+age ou ExternalSecretsOperator
# (voir docs/runbooks/secret-rotation.md).

# ── auth-users ────────────────────────────────────────────────
AUTH_DATABASE_URL=postgresql+psycopg://securerag:CHANGE_ME@postgres:5432/securerag
AUTH_JWT_SECRET=CHANGE_ME_TO_A_RANDOM_32_PLUS_CHARS_STRING
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_TTL_SECONDS=3600
AUTH_BCRYPT_ROUNDS=12

# ── vectorstore-service ───────────────────────────────────────
VECTORSTORE_QDRANT_URL=http://qdrant:6333
VECTORSTORE_QDRANT_API_KEY=
VECTORSTORE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTORSTORE_CHUNK_SIZE=512
VECTORSTORE_CHUNK_OVERLAP=64

# ── llm-orchestrator ──────────────────────────────────────────
LLM_OLLAMA_URL=http://ollama:11434
LLM_OLLAMA_MODEL=llama3:8b
LLM_USE_MOCK=true                       # true en CI/tests
LLM_HISTORY_MAX_TURNS=6
LLM_TIMEOUT_SECONDS=30

# ── security-auditor ──────────────────────────────────────────
AUDITOR_LOG_RAW_PROMPT=false            # JAMAIS true en production
AUDITOR_BLOCK_THRESHOLD=70
AUDITOR_FLAG_THRESHOLD=40

# ── api-gateway ───────────────────────────────────────────────
GATEWAY_AUTH_USERS_URL=http://auth-users:8080
GATEWAY_VECTORSTORE_URL=http://vectorstore-service:8080
GATEWAY_LLM_ORCHESTRATOR_URL=http://llm-orchestrator:8080
GATEWAY_AUDITOR_URL=http://security-auditor:8080
GATEWAY_JWT_SECRET=${AUTH_JWT_SECRET}    # même secret que auth-users
GATEWAY_TIMEOUT_SECONDS=15
GATEWAY_RATE_LIMIT_PER_MINUTE=60
GATEWAY_CORS_ALLOW_ORIGINS=http://localhost:8080

# ── infrastructure ────────────────────────────────────────────
POSTGRES_DB=securerag
POSTGRES_USER=securerag
POSTGRES_PASSWORD=CHANGE_ME_DEV_ONLY

# Observabilité — Jenkins / GitHub Actions
JENKINS_URL=http://localhost:8080
GITHUB_REPO=YassinoMed/MasterPFE

# Ne pas ajouter de token ici. Utiliser des credentials Jenkins :
# - github-token (lecture/écriture repo)
# - cosign-private-key + cosign-password (signature images)
# - sops-age-key (déchiffrement secrets)
# - sonar-token (Sonar quality gate)
