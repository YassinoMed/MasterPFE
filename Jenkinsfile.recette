pipeline {
    agent any

    triggers {
        githubPush()
        upstream(upstreamProjects: 'securerag-hub-ci', threshold: hudson.model.Result.SUCCESS)
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 45, unit: 'MINUTES')
        ansiColor('xterm')
    }

    parameters {
        string(
            name: 'RECETTE_HOST',
            defaultValue: '83.229.82.46',
            description: 'Adresse IP ou hostname du serveur recette'
        )

        string(
            name: 'RECETTE_USER',
            defaultValue: 'root',
            description: 'Utilisateur SSH'
        )
    }

    environment {
        SSH_OPTIONS = '-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
    }

    stages {

        stage('Checkout') {
            steps {
                deleteDir()
                checkout scm

                sh '''
                    find scripts -type f -name "*.sh" -exec chmod +x {} + || true
                '''
            }
        }

        stage('Connectivity Check') {
            steps {

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'recette-deploy-ssh-key',
                        keyFileVariable: 'SSH_KEY_FILE'
                    )
                ]) {

                    sh '''
                        ssh -i "$SSH_KEY_FILE" ${SSH_OPTIONS} \
                        ${RECETTE_USER}@${RECETTE_HOST} \
                        "echo 'SSH connection successful'"
                    '''
                }
            }
        }

        stage('Deploy To Recette') {

            steps {

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'recette-deploy-ssh-key',
                        keyFileVariable: 'SSH_KEY_FILE'
                    )
                ]) {

                    sh '''
                        ssh -i "$SSH_KEY_FILE" ${SSH_OPTIONS} ${RECETTE_USER}@${RECETTE_HOST} << 'EOF'

                        set -euo pipefail

                        echo "===== SecureRAG Hub Deployment ====="

                        if [ ! -d "/root/MasterPFE" ]; then
                            git clone https://github.com/YassinoMed/MasterPFE.git /root/MasterPFE
                        fi

                        cd /root/MasterPFE

                        echo "===== Updating repository ====="

                        git fetch origin
                        git reset --hard origin/main

                        echo "===== Building Docker images ====="

                        bash scripts/deploy/build-local-images.sh

                        echo "===== Starting Kind cluster ====="

                        bash scripts/deploy/deploy-kind.sh || true

                        echo "===== Waiting for deployments ====="

                        kubectl rollout status deployment/portal-web \
                            -n securerag-hub --timeout=300s || true

                        kubectl rollout status deployment/auth-users \
                            -n securerag-hub --timeout=300s || true

                        kubectl rollout status deployment/chatbot-manager \
                            -n securerag-hub --timeout=300s || true

                        kubectl rollout status deployment/conversation-service \
                            -n securerag-hub --timeout=300s || true

                        kubectl rollout status deployment/audit-security-service \
                            -n securerag-hub --timeout=300s || true

                        echo "===== Cluster status ====="

                        kubectl get pods -A
                        kubectl get svc -A
                        kubectl get ingress -A

                        echo "===== Deployment completed successfully ====="

                        EOF
                    '''
                }
            }
        }
    }

    post {

        success {
            echo "✅ SecureRAG Hub recette deployment successful"
        }

        failure {
            echo "❌ SecureRAG Hub recette deployment failed"
        }

        aborted {
            echo "⚠ Build aborted"
        }

        always {
            cleanWs(
                deleteDirs: true,
                notFailBuild: true
            )
        }
    }
}