pipeline {
    agent any

    triggers {
        githubPush()
        upstream(upstreamProjects: 'securerag-hub-ci', threshold: hudson.model.Result.SUCCESS)
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 45, unit: 'MINUTES')
        ansiColor('xterm')
    }

    parameters {
        string(
            name: 'RECETTE_HOST',
            defaultValue: '83.229.82.46',
            description: 'Adresse IP ou hostname du serveur recette'
        )

        string(
            name: 'RECETTE_USER',
            defaultValue: 'root',
            description: 'Utilisateur SSH'
        )
    }

    environment {
        SSH_OPTIONS = '-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
    }

    stages {

        stage('Checkout') {
            steps {
                deleteDir()
                checkout scm

                sh '''
                    find scripts -type f -name "*.sh" -exec chmod +x {} + || true
                '''
            }
        }

        stage('Connectivity Check') {
            steps {

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'recette-deploy-ssh-key',
                        keyFileVariable: 'SSH_KEY_FILE'
                    )
                ]) {

                    sh '''
                        ssh -i "$SSH_KEY_FILE" ${SSH_OPTIONS} \
                        ${RECETTE_USER}@${RECETTE_HOST} \
                        "echo 'SSH connection successful'"
                    '''
                }
            }
        }

        stage('Deploy To Recette') {

            steps {

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'recette-deploy-ssh-key',
                        keyFileVariable: 'SSH_KEY_FILE'
                    )
                ]) {

                    sh '''
                        ssh -i "$SSH_KEY_FILE" ${SSH_OPTIONS} ${RECETTE_USER}@${RECETTE_HOST} "IMAGE_TAG='${IMAGE_TAG}' bash -s" << 'EOF'

                        set -euo pipefail

                        echo "===== SecureRAG Hub Deployment ====="

                        if [ ! -d "/root/MasterPFE" ]; then
                            git clone https://github.com/YassinoMed/MasterPFE.git /root/MasterPFE
                        fi

                        cd /root/MasterPFE

                        echo "===== Updating repository ====="

                        git fetch origin
                        git reset --hard origin/main

                        echo "===== Building Docker images ====="

                        REGISTRY_HOST="localhost:5001" IMAGE_TAG="${IMAGE_TAG}" bash scripts/deploy/build-local-images.sh

                        echo "===== Updating GitOps manifests ====="

                        git config --global user.email "jenkins@securerag.local"
                        git config --global user.name "Jenkins GitOps Bot"

                        for service in auth-users chatbot-manager conversation-service audit-security-service portal-web; do
                            image_name="localhost:5001/securerag-hub-${service}:${IMAGE_TAG}"
                            digest=$(docker inspect --format='{{index .RepoDigests 0}}' "${image_name}" 2>/dev/null | cut -d'@' -f2 || true)
                            if [ -n "$digest" ]; then
                                echo "Updating digest for $service to $digest"
                                bash scripts/gitops/update-image-digest.sh recette "$service" "$digest"
                            else
                                echo "[WARN] No digest found for ${service}"
                            fi
                        done

                        echo "===== Waiting for ArgoCD sync and rollout ====="

                        kubectl annotate application securerag-recette -n argocd argocd.argoproj.io/refresh=normal --overwrite || true

                        if command -v argocd &>/dev/null; then
                            argocd app sync securerag-recette --prune --timeout 300 || true
                            argocd app wait securerag-recette --timeout 300 || true
                        fi

                        for deploy in portal-web auth-users chatbot-manager conversation-service audit-security-service; do
                            kubectl rollout status "deployment/${deploy}" -n securerag-hub --timeout=300s || true
                        done

                        echo "===== Cluster status ====="

                        kubectl get pods -A
                        kubectl get svc -A
                        kubectl get ingress -A

                        echo "===== Deployment completed successfully ====="

EOF
                    '''
                }
            }
        }

        stage('Smoke Tests') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'recette-deploy-ssh-key',
                        keyFileVariable: 'SSH_KEY_FILE'
                    )
                ]) {
                    sh '''
                        ssh -i "$SSH_KEY_FILE" ${SSH_OPTIONS} ${RECETTE_USER}@${RECETTE_HOST} "bash -s" << 'EOF'
                        set -euo pipefail
                        cd /root/MasterPFE
                        echo "===== Running Smoke Tests ====="
                        NS="securerag-hub" REPORT_DIR="reports/postdeploy" bash scripts/validate/smoke-tests.sh
EOF
                    '''
                }
            }
        }
    }

    post {

        success {
            echo "✅ SecureRAG Hub recette deployment successful"
        }

        failure {
            echo "❌ SecureRAG Hub recette deployment failed"
        }

        aborted {
            echo "⚠ Build aborted"
        }

        always {
            cleanWs(
                deleteDirs: true,
                notFailBuild: true
            )
        }
    }
}