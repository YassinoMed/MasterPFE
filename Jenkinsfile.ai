pipeline {
  agent {
    kubernetes {
      yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins
  containers:
  - name: tools
    # [MLSecOps] Registry local : Docker Hub rate-limité depuis le cluster.
    # Image pré-pull-ée et push-ée vers localhost:5001 (kind-registry).
    image: kind-registry.registry.svc.cluster.local:5001/securerag-hub-unified:latest
    imagePullPolicy: Always
    command:
    - cat
    tty: true
    # [FIX WORKSPACE] Pas de volume custom : le workspaceVolume du plugin
    # kubernetes (déclaré ci-dessous) est monté au MÊME chemin dans TOUS
    # les containers (jnlp + tools + kaniko) — sinon l'unstash écrit dans
    # le volume du jnlp et le sh des side-containers ne voit rien.
    volumeMounts:
    - name: composer-cache
      mountPath: /home/jenkins/.composer/cache
    - name: npm-cache
      mountPath: /home/jenkins/.npm
    - name: pip-cache
      mountPath: /home/jenkins/.cache/pip
    - name: trivy-cache
      mountPath: /home/jenkins/.trivycache
    - name: semgrep-cache
      mountPath: /home/jenkins/.semgrep
    - name: sonar-cache
      mountPath: /home/jenkins/.sonar
    - name: maven-cache
      mountPath: /home/jenkins/.m2

  # Kaniko executor (rootless, no privileged)
  - name: kaniko
    image: kind-registry.registry.svc.cluster.local:5001/kaniko-executor:v1.23.2-debug
    imagePullPolicy: IfNotPresent
    command:
    - /busybox/cat
    tty: true
    # [FIX WORKSPACE] idem tools : workspaceVolume partagé, pas de volume custom
    volumeMounts:
    - name: docker-config
      mountPath: /kaniko/.docker

  volumes:
  - name: docker-config
    emptyDir: {}
  # [SECURITÉ] hostPath remplacé par emptyDir : la PSA "baseline" du
  # namespace jenkins interdit hostPath (et c'est une bonne pratique —
  # un agent CI n'a pas à toucher le filesystem du node).
  - name: composer-cache
    emptyDir: {}
  - name: npm-cache
    emptyDir: {}
  - name: pip-cache
    emptyDir: {}
  - name: trivy-cache
    emptyDir: {}
  - name: semgrep-cache
    emptyDir: {}
  - name: sonar-cache
    emptyDir: {}
  - name: maven-cache
    emptyDir: {}
'''
      defaultContainer 'tools'
      // [FIX WORKSPACE] Volume partagé entre jnlp/tools/kaniko au même
      // chemin (/home/jenkins/agent) — remplace le volume custom qui
      // était DÉCONNECTÉ de celui du jnlp (cause du 'cd: can't cd').
      workspaceVolume emptyDirWorkspaceVolume()
    }
  }

  options {
    // timestamps()/ansiColor retirés : plugins absents du Jenkins kind
    // (options cosmétiques — la sécurité du pipeline est inchangée)
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '10'))
    timeout(time: 30, unit: 'MINUTES')
    skipDefaultCheckout()
  }

  environment {
    REGISTRY_HOST = 'localhost:5001'
    IMAGE_PREFIX  = 'ai-security'
    IMAGE_TAG     = 'production'
    NAMESPACE     = 'ai-security'

    COMPOSER_HOME       = '/home/jenkins/.composer'
    COMPOSER_CACHE_DIR  = '/home/jenkins/.composer/cache'
    npm_config_cache    = '/home/jenkins/.npm'
    NPM_CONFIG_CACHE    = '/home/jenkins/.npm'
    PIP_CACHE_DIR       = '/home/jenkins/.cache/pip'
    TRIVY_CACHE_DIR     = '/home/jenkins/.trivycache'
    SEMGREP_CACHE_DIR   = '/home/jenkins/.semgrep'
    SONAR_USER_HOME     = '/home/jenkins/.sonar'
  }

  stages {
    stage('Prepare Workspace') {
      steps {
        retry(3) {
          timeout(time: 5, unit: 'MINUTES') {
            checkout scm
          }
        }
        stash name: 'workspace', excludes: '.git/**, .trivycache/**, .semgrep/**, .sonar/**'
      }
    }

    stage('Lint & Static Analysis') {
      steps {
        unstash 'workspace'
        sh '''
          #!/bin/bash
          set -euo pipefail
          # [MLSecOps] SAST avec semgrep + RÈGLES LOCALES du repo
          # (security/semgrep/) — outil RÉELLEMENT présent dans l'image
          # CI. flake8 (style) est optionnel : absent de l'image.
          echo "[INFO] SAST semgrep (règles locales security/semgrep/)..."
          if command -v semgrep >/dev/null 2>&1; then
            semgrep --config security/semgrep/semgrep.yml --error --quiet ai-security/ secai/ || {
              echo "[FAIL] semgrep a trouvé des violations bloquantes"
              exit 1
            }
            echo "[OK] semgrep SAST : aucune violation bloquante"
          else
            echo "[ERROR] semgrep absent du conteneur CI"
            exit 1
          fi
          echo "[INFO] (flake8 style-check optionnel : $(command -v flake8 >/dev/null 2>&1 && echo disponible || echo absent — SAST semgrep reste la barrière))"
        '''
      }
    }

    stage('Unit Tests') {
      steps {
        unstash 'workspace'
        sh '''
          #!/bin/bash
          set -euo pipefail
          echo "[INFO] Running Python tests..."
          export PYTHONPATH="$PYTHONPATH:$(pwd)/ai-security/backend"
          if command -v pytest >/dev/null 2>&1; then
            pytest ai-security/backend/tests/ -v --tb=short
          else
            # pytest absent de l'image CI : tenter une installation bornée
            # (90s max) puis fallback unittest discover — on ne saute
            # JAMAIS silencieusement les tests.
            echo "[INFO] pytest absent — installation tentée (90s max)..."
            if timeout 90 pip3 install --quiet pytest 2>/dev/null && python3 -m pytest --version >/dev/null 2>&1; then
              python3 -m pytest ai-security/backend/tests/ -v --tb=short
            else
              echo "[INFO] Installation impossible — fallback unittest discover"
              python3 -m unittest discover -s ai-security/backend/tests -p "test_*.py" -v
            fi
          fi
        '''
      }
    }

    stage('Live Secret Verification (TruffleHog)') {
      steps {
        unstash 'workspace'
        sh '''
          #!/bin/bash
          set -euo pipefail
          # [MLSecOps] detect-secrets (Yelp) : scanner de secrets RÉEL
          # présent dans l'image CI (trufflehog binaire absent de l'image).
          echo "[INFO] Scan de secrets actifs avec detect-secrets..."
          if command -v detect-secrets >/dev/null 2>&1; then
            detect-secrets scan --force-use-all-plugins \
              --exclude-files 'node_modules|\.git|\.venv|test-reports|__pycache__' \
              > /tmp/secrets-baseline.json
            # Audit : des secrets RÉELS (hors tests/fixtures) font échouer le build
            detect-secrets audit --report-json /tmp/secrets-baseline.json --display-results 2>/dev/null | tee /tmp/secrets-report.txt
            HIGH=$(python3 -c "
import json
with open('/tmp/secrets-baseline.json') as f:
    d = json.load(f)
# Les résultats de plugins = candidats secrets ; les fichiers de TEST et les fixtures sont exclus
real = [loc for fp, res in d.get('results', {}).items()
        for loc in res if 'test' not in fp.lower() and 'fixture' not in fp.lower()]
print(len(real))")
            echo "[INFO] Candidats secrets hors tests : $HIGH"
            if [ "$HIGH" -gt 0 ]; then
              echo "[FAIL] $HIGH secret(s) potentiel(s) détecté(s) — voir /tmp/secrets-report.txt"
              exit 1
            fi
            echo "[OK] Aucun secret actif détecté hors fixtures de test"
          else
            echo "[ERROR] detect-secrets absent du conteneur CI"
            exit 1
          fi
        '''
      }
    }

    stage('MLSecOps Security & LLM Red-Teaming') {
      steps {
        unstash 'workspace'
        sh '''
          #!/bin/bash
          set -euo pipefail
          echo "[INFO] Running MLSecOps Security Suite..."
          # [2026-09-28] La suite est désormais RÉELLE :
          #   1/3 picklescan (install bornée 90s, sinon fallback scan fichiers)
          #   2/3 garak si endpoint LLM joignable, SINON suite red-teaming
          #       réelle contre les guardrails SECAI (13 payloads, stdlib pur)
          #   3/3 audit supply chain
          echo "[INFO] Tentative installation picklescan (90s max)..."
          timeout 90 pip3 install --quiet picklescan 2>/dev/null || \
            echo "[WARN] picklescan non installable — le script utilisera son fallback (scan fichiers)"
          bash scripts/ci/run-mlsecops-scans.sh
        '''
      }
    }

    stage('Build Images with Kaniko (rootless)') {
      steps {
        unstash 'workspace'
        container('kaniko') {
          sh '''
            #!/bin/bash
            set -euo pipefail
            echo "[INFO] Building AI images with Kaniko (rootless)..."

            /kaniko/executor \
              --context=/workspace/ai-security \
              --dockerfile=/workspace/ai-security/Dockerfile \
              --destination=${REGISTRY_HOST}/${IMAGE_PREFIX}-inference:${IMAGE_TAG} \
              --cache=true \
              --cache-ttl=24h

            /kaniko/executor \
              --context=/workspace/ai-security/backend \
              --dockerfile=/workspace/ai-security/backend/Dockerfile \
              --destination=${REGISTRY_HOST}/${IMAGE_PREFIX}-backend:${IMAGE_TAG} \
              --cache=true \
              --cache-ttl=24h

            /kaniko/executor \
              --context=/workspace/ai-security \
              --dockerfile=/workspace/ai-security/Dockerfile.collector \
              --destination=${REGISTRY_HOST}/${IMAGE_PREFIX}-log-collector:${IMAGE_TAG} \
              --cache=true \
              --cache-ttl=24h

            /kaniko/executor \
              --context=/workspace/ai-security/frontend \
              --dockerfile=/workspace/ai-security/frontend/Dockerfile \
              --destination=${REGISTRY_HOST}/${IMAGE_PREFIX}-frontend:${IMAGE_TAG} \
              --cache=true \
              --cache-ttl=24h
          '''
        }
      }
    }

    stage('Trivy Image Scan (blocking)') {
      steps {
        unstash 'workspace'
        sh '''
          #!/bin/bash
          set -euo pipefail
          echo "[INFO] Running Trivy container vulnerability scan (CRITICAL = fail)..."
          trivy image --severity CRITICAL --exit-code 1 ${REGISTRY_HOST}/${IMAGE_PREFIX}-backend:${IMAGE_TAG}
          trivy image --severity CRITICAL --exit-code 1 ${REGISTRY_HOST}/${IMAGE_PREFIX}-inference:${IMAGE_TAG}
          trivy image --severity CRITICAL --exit-code 1 ${REGISTRY_HOST}/${IMAGE_PREFIX}-log-collector:${IMAGE_TAG}
          trivy image --severity CRITICAL --exit-code 1 ${REGISTRY_HOST}/${IMAGE_PREFIX}-frontend:${IMAGE_TAG}
        '''
      }
    }

    stage('Cosign Sign (blocking)') {
      steps {
        sh '''
          #!/bin/bash
          set -euo pipefail
          echo "[INFO] Signing images with Cosign..."
          if ! command -v cosign >/dev/null 2>&1; then
            echo "[ERROR] cosign not installed"
            exit 1
          fi
          cosign sign --key k8s://securerag-hub/cosign-private-key --yes \
            ${REGISTRY_HOST}/${IMAGE_PREFIX}-backend:${IMAGE_TAG}
          cosign sign --key k8s://securerag-hub/cosign-private-key --yes \
            ${REGISTRY_HOST}/${IMAGE_PREFIX}-inference:${IMAGE_TAG}
        '''
      }
    }

    stage('Kubernetes Deploy') {
      steps {
        unstash 'workspace'
        sh '''
          #!/bin/bash
          set -euo pipefail
          echo "[INFO] Applying Kubernetes manifests..."
          kubectl apply -f ai-security/k8s/namespace.yaml
          kubectl apply -f ai-security/k8s/

          echo "[INFO] Waiting for deployments rollout..."
          kubectl rollout status deployment/ai-security-inference -n ${NAMESPACE} --timeout=180s
          kubectl rollout status deployment/ai-security-backend -n ${NAMESPACE} --timeout=180s
          kubectl rollout status deployment/ai-security-frontend -n ${NAMESPACE} --timeout=180s

          echo "[INFO] AI Security Layer deployed successfully."
        '''
      }
    }
  }

  post {
    success {
      echo "[OK] AI Security Layer CI/CD pipeline completed successfully."
    }
    failure {
      echo "[FAIL] Pipeline failed. Check console logs."
    }
    always {
      // cleanWs nécessite le plugin ws-cleanup (absent du Jenkins kind)
      // deleteDir() est l'équivalent natif — supprime le workspace.
      deleteDir()
    }
  }
}