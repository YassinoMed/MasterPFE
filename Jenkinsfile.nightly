pipeline {
  agent {
    kubernetes {
      yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins
  containers:
  - name: tools
    image: mohamedyassinebouneb/securerag-hub-unified:latest
    imagePullPolicy: Always
    command:
    - cat
    tty: true
    volumeMounts:
    - name: composer-cache
      mountPath: /home/jenkins/.composer/cache
    - name: npm-cache
      mountPath: /home/jenkins/.npm
    - name: pip-cache
      mountPath: /home/jenkins/.cache/pip
    - name: trivy-cache
      mountPath: /home/jenkins/.trivycache
    - name: semgrep-cache
      mountPath: /home/jenkins/.semgrep
    - name: sonar-cache
      mountPath: /home/jenkins/.sonar
  volumes:
  - name: composer-cache
    hostPath:
      path: /var/cache/jenkins/composer-cache-pvc
  - name: npm-cache
    hostPath:
      path: /var/cache/jenkins/npm-cache-pvc
  - name: pip-cache
    hostPath:
      path: /var/cache/jenkins/pip-cache
  - name: trivy-cache
    hostPath:
      path: /var/cache/jenkins/trivy-cache-pvc
  - name: semgrep-cache
    hostPath:
      path: /var/cache/jenkins/semgrep-cache
  - name: sonar-cache
    hostPath:
      path: /var/cache/jenkins/sonar-cache-pvc
'''
      defaultContainer 'tools'
    }
  }

  triggers {
    cron('0 3 * * *')
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '30'))
    timeout(time: 45, unit: 'MINUTES')
    ansiColor('xterm')
    skipDefaultCheckout()
  }

  environment {
    LARAVEL_APPS = 'platform/portal-web services-laravel/auth-users-service services-laravel/chatbot-manager-service services-laravel/conversation-service services-laravel/audit-security-service'
    REPORT_DIR = 'security/reports'
  }

  stages {
    stage('Prepare Workspace') {
      steps {
        retry(3) {
          timeout(time: 5, unit: 'MINUTES') {
            checkout scm
          }
        }
        stash name: 'workspace', excludes: '.git/**, .trivycache/**, .semgrep/**, .sonar/**'
      }
    }

    stage('Nightly Heavy Scans & DR Validation') {
      parallel {
        stage('OWASP Dependency-Check Scan') {
          steps {
            timeout(time: 20, unit: 'MINUTES') {
              unstash 'workspace'
              sh 'bash scripts/ci/run-owasp-dependency-check.sh || echo "[WARN] OWASP Dependency Check finished with issues"'
            }
          }
          post {
            always {
              publishHTML(target: [
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'security/reports',
                reportFiles: 'dependency-check-*/dependency-check-report.html',
                reportName: 'OWASP Dependency-Check Report'
              ])
              archiveArtifacts allowEmptyArchive: true, artifacts: 'security/reports/dependency-check-*/*'
            }
          }
        }

        stage('OWASP ZAP DAST Full Scan') {
          steps {
            timeout(time: 20, unit: 'MINUTES') {
              unstash 'workspace'
              sh 'bash scripts/ci/run-owasp-zap-dast.sh || echo "[WARN] OWASP ZAP DAST finished with issues"'
            }
          }
          post {
            always {
              archiveArtifacts allowEmptyArchive: true, artifacts: 'reports/zap-*'
            }
          }
        }

        stage('LLM Red Teaming & Prompt Fuzzing (Garak)') {
          steps {
            timeout(time: 15, unit: 'MINUTES') {
              unstash 'workspace'
              sh '''
                set -euo pipefail
                echo "[INFO] Running Garak LLM vulnerability & prompt injection red-teaming..."
                if python3 -c "import garak" >/dev/null 2>&1; then
                  python3 -m garak --model_type rest --report_prefix security/reports/garak_report || echo "[WARN] Garak red-teaming finished with non-blocking warnings"
                else
                  echo "[INFO] Garak security check simulated."
                fi
              '''
            }
          }
        }

        stage('Backup & Restore DR Validation') {
          steps {
            timeout(time: 15, unit: 'MINUTES') {
              unstash 'workspace'
              sh '''
                set -euo pipefail
                echo "═══ NIGHTLY DR TEST — BACKUP & RESTORE VALIDATION ═══"
                if command -v velero &>/dev/null || kubectl get deployment -n velero velero &>/dev/null 2>&1; then
                  bash scripts/dr/backup-test.sh || echo "[WARN] Backup test had issues"
                  bash scripts/dr/validate-restore.sh || echo "[WARN] Restore validation had issues"
                else
                  echo "[WARN] Velero not installed — DR test skipped"
                fi
              '''
            }
          }
          post {
            always {
              archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/validation/restore-drill-*.md,artifacts/dr/*.md'
            }
          }
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts allowEmptyArchive: true, artifacts: 'security/reports/**,artifacts/validation/**'
      cleanWs deleteDirs: true, notFailBuild: true
    }
  }
}
