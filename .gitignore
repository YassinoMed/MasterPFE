.DS_Store
.claude/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
.tools/
.coverage
.coverage-artifacts/
**/coverage.xml
**/coverage-report/
.trivycache/
artifacts/validation/
artifacts/jenkins/
artifacts/support-pack/
artifacts/final/rendered-overlay.yaml
security/reports/*.json
security/reports/*.txt
security/reports/*.cdx.json
security/secrets/.env.local

# ── Secrets — jamais de credentials en clair dans Git ──────────
infra/jenkins/secrets/
infra/jenkins/secrets/**/*

# ── OPA Gatekeeper — suivis malgré *.yaml ──
!infra/k8s/opa-gatekeeper/**/*.yaml

# ── SOPS — fichiers encryptés commités, fichiers en clair exclus ──
# Allow all infra Kubernetes/Helm manifests (critical for ArgoCD GitOps)
!infra/k8s/**/*.yaml
!infra/helm/**/*.yaml

# Exclude decrypted secret files (only encrypted versions should be committed)
infra/secrets/production/*.yaml
!infra/secrets/production/*.enc.yaml
infra/secrets/dev/*.yaml
!infra/secrets/dev/*.enc.yaml
infra/secrets/demo/*.yaml
!infra/secrets/demo/*.enc.yaml

# ── Age private keys (ne jamais commiter) ─────────────────────
age-key*
!age-key*
*.age-key
keys.txt
sops/age/keys.txt
~/.config/sops/age/keys.txt

# ── Kubeconfig (ne jamais commiter) ───────────────────────────
kubeconfig
*.kubeconfig
.kube/config

# ── Cosign keys (remplacées par keyless) ──────────────────────
cosign.key
cosign.pub
cosign.password

# ── Terraform state / vars ────────────────────────────────────
*.tfstate
*.tfstate.*
*.tfvars
terraform.tfvars
override.tf
override.tf.json
.terraform/
reports/
*.env
