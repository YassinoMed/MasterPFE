pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  parameters {
    string(
      name: 'REGISTRY_HOST',
      defaultValue: 'localhost:5001',
      description: 'Target OCI registry used for release artifacts.'
    )
    string(
      name: 'IMAGE_PREFIX',
      defaultValue: 'securerag-hub',
      description: 'OCI image prefix used by the microservices.'
    )
    string(
      name: 'SOURCE_IMAGE_TAG',
      defaultValue: 'dev',
      description: 'Existing signed image tag used as the release candidate.'
    )
    string(
      name: 'TARGET_IMAGE_TAG',
      defaultValue: 'release-local',
      description: 'Promoted image tag deployed after verification.'
    )
    booleanParam(
      name: 'RUN_DEPLOY_KIND',
      defaultValue: true,
      description: 'Deploy the verified images to the local kind cluster.'
    )
    booleanParam(
      name: 'SIGN_RELEASE_CANDIDATES',
      defaultValue: true,
      description: 'Sign release candidate images before verification using Jenkins Cosign credentials.'
    )
    booleanParam(
      name: 'RUN_POSTDEPLOY_VALIDATION',
      defaultValue: true,
      description: 'Run post-deployment validation after deployment.'
    )
    booleanParam(
      name: 'RUN_DAST',
      defaultValue: true,
      description: 'Run OWASP ZAP DAST baseline scan against the deployed portal. Requires Docker and a running portal-web service.'
    )
    string(
      name: 'NOTIFICATION_EMAIL',
      defaultValue: 'med.yassine.bouneb@proton.me',
      description: 'Email address to notify on build failures. Leave empty to disable.'
    )
  }

  environment {
    SBOM_DIR = 'artifacts/sbom'
    REPORT_DIR = 'artifacts/release'
    COSIGN_YES = 'true'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Prepare Workspace') {
      steps {
        sh '''
          set -euo pipefail
          mkdir -p "${SBOM_DIR}" "${REPORT_DIR}" artifacts/validation
          find scripts -type f -name "*.sh" -exec chmod +x {} +
          chmod +x infra/kind/registry-config.sh
        '''
      }
    }

    stage('CD_IMAGE_SCAN - Scan Release Candidate Images') {
      steps {
        sh '''
          set -euo pipefail
          REGISTRY_HOST="${REGISTRY_HOST}" IMAGE_PREFIX="${IMAGE_PREFIX}" IMAGE_TAG="${SOURCE_IMAGE_TAG}" \
          REPORT_DIR="${REPORT_DIR}" IMAGE_SCAN_DIR="security/reports" \
          TRIVY_BLOCKING_SEVERITY="CRITICAL" TRIVY_FAIL_ON_HIGH="false" \
          bash scripts/release/scan-images.sh
        '''
      }
      post {
        always {
          archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/release/image-scan-summary.txt,artifacts/release/image-scan-summary.md,artifacts/release/image-scan-index.json,artifacts/release/*-image-scan.log,security/reports/trivy-image-*.json'
        }
      }
    }

    stage('Sign Release Candidate Images') {
      when {
        expression { return params.SIGN_RELEASE_CANDIDATES }
      }
      steps {
        withCredentials([
          file(credentialsId: 'cosign-private-key', variable: 'COSIGN_KEY'),
          string(credentialsId: 'cosign-password', variable: 'COSIGN_PASSWORD')
        ]) {
          sh '''
            set -euo pipefail
            REGISTRY_HOST="${REGISTRY_HOST}" IMAGE_PREFIX="${IMAGE_PREFIX}" IMAGE_TAG="${SOURCE_IMAGE_TAG}" \
            REPORT_DIR="${REPORT_DIR}" COSIGN_KEY="${COSIGN_KEY}" FAIL_FAST="true" \
            bash scripts/release/sign-images.sh
          '''
        }
      }
      post {
        always {
          archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/release/sign-summary.txt,artifacts/release/sign-summary.md,artifacts/release/sign-index.json,artifacts/release/*-sign.log'
        }
      }
    }

    stage('Verify Release Candidate Signatures') {
      steps {
        withCredentials([
          file(credentialsId: 'cosign-public-key', variable: 'COSIGN_PUBLIC_KEY')
        ]) {
          sh '''
            set -euo pipefail
            REGISTRY_HOST="${REGISTRY_HOST}" IMAGE_PREFIX="${IMAGE_PREFIX}" IMAGE_TAG="${SOURCE_IMAGE_TAG}" \
            REPORT_DIR="${REPORT_DIR}" COSIGN_PUBLIC_KEY="${COSIGN_PUBLIC_KEY}" \
            bash scripts/release/verify-signatures.sh
          '''
        }
      }
      post {
        always {
          archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/release/*verify*,artifacts/release/verify-index.json'
        }
      }
    }

    stage('Promote Verified Images by Digest') {
      steps {
        withCredentials([
          file(credentialsId: 'cosign-public-key', variable: 'COSIGN_PUBLIC_KEY')
        ]) {
          sh '''
            set -euo pipefail
            REGISTRY_HOST="${REGISTRY_HOST}" IMAGE_PREFIX="${IMAGE_PREFIX}" \
            SOURCE_IMAGE_TAG="${SOURCE_IMAGE_TAG}" TARGET_IMAGE_TAG="${TARGET_IMAGE_TAG}" \
            REPORT_DIR="${REPORT_DIR}" DIGEST_RECORD_FILE="${REPORT_DIR}/promotion-digests.txt" \
            COSIGN_PUBLIC_KEY="${COSIGN_PUBLIC_KEY}" \
            VERIFY_SOURCE_BEFORE_PROMOTION=false VERIFY_TARGET_AFTER_PROMOTION=true \
            bash scripts/release/promote-by-digest.sh
          '''
        }
      }
      post {
        always {
          archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/release/*promot*,artifacts/release/*digest*,artifacts/release/*verify*'
        }
      }
    }

    stage('Generate SBOM') {
      steps {
        sh '''
          set -euo pipefail
          REGISTRY_HOST="${REGISTRY_HOST}" IMAGE_PREFIX="${IMAGE_PREFIX}" IMAGE_TAG="${TARGET_IMAGE_TAG}" \
          SBOM_DIR="${SBOM_DIR}" REPORT_DIR="${REPORT_DIR}" \
          bash scripts/release/generate-sbom.sh
          STRICT_SBOM_VALIDATION="true" SBOM_DIR="${SBOM_DIR}" REPORT_DIR="${REPORT_DIR}" \
          bash scripts/release/validate-sbom-cyclonedx.sh
        '''
      }
      post {
        always {
          archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/sbom/**,artifacts/release/sbom-summary.txt,artifacts/release/sbom-summary.md,artifacts/release/sbom-cyclonedx-validation.md'
        }
      }
    }

    stage('SBOM Analysis — Grype') {
      steps {
        sh '''
          set -euo pipefail
          echo "[INFO] Running Grype on generated SBOMs"
          
          fail=0
          for sbom in "${SBOM_DIR}"/*.cyclonedx.json; do
            [ -e "$sbom" ] || continue
            echo "Scanning $sbom..."
            grype "sbom:$sbom" --fail-on high,critical -o json > "${sbom}.grype.json" || fail=1
          done
          
          if [ $fail -eq 1 ]; then
            echo "[ERROR] Grype found High or Critical vulnerabilities in SBOMs."
            exit 1
          fi
        '''
      }
      post {
        always {
          archiveArtifacts allowEmptyArchive: true, artifacts: '${SBOM_DIR}/*.grype.json'
        }
      }
    }

    stage('Attest SBOMs') {
      steps {
        withCredentials([
          file(credentialsId: 'cosign-private-key', variable: 'COSIGN_KEY'),
          string(credentialsId: 'cosign-password', variable: 'COSIGN_PASSWORD')
        ]) {
          sh '''
            set -euo pipefail
            REGISTRY_HOST="${REGISTRY_HOST}" IMAGE_PREFIX="${IMAGE_PREFIX}" IMAGE_TAG="${TARGET_IMAGE_TAG}" \
            SBOM_DIR="${SBOM_DIR}" REPORT_DIR="${REPORT_DIR}" COSIGN_KEY="${COSIGN_KEY}" \
            bash scripts/release/attest-sboms.sh
          '''
        }
      }
      post {
        always {
          archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/release/attest-summary.txt,artifacts/release/*-attest.log'
        }
      }
    }

    stage('Assert Mandatory Supply Chain Evidence') {
      steps {
        sh '''
          set -euo pipefail
          REPORT_DIR="${REPORT_DIR}" SBOM_DIR="${SBOM_DIR}" \
          DIGEST_RECORD_FILE="${REPORT_DIR}/promotion-digests.txt" \
          REQUIRE_SUPPLY_CHAIN_EVIDENCE="true" \
          bash scripts/release/assert-supply-chain-evidence.sh
        '''
      }
      post {
        always {
          archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/release/supply-chain-gate-report.md'
        }
      }
    }

    stage('Generate Release Attestation') {
      steps {
        sh '''
          set -euo pipefail
          REPORT_DIR="${REPORT_DIR}" SBOM_DIR="${SBOM_DIR}" \
          DIGEST_RECORD_FILE="${REPORT_DIR}/promotion-digests.txt" \
          STRICT_RELEASE_ATTESTATION="true" \
          bash scripts/release/generate-release-attestation.sh
        '''
      }
      post {
        always {
          archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/release/release-attestation.json,artifacts/release/release-attestation.md'
        }
      }
    }

    stage('Generate SLSA-style Provenance') {
      steps {
        sh '''
          set -euo pipefail
          REPORT_DIR="${REPORT_DIR}" DIGEST_RECORD_FILE="${REPORT_DIR}/promotion-digests.txt" \
          STRICT_PROVENANCE="true" \
          bash scripts/release/generate-provenance-statement.sh
        '''
      }
      post {
        always {
          archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/release/provenance.slsa.json,artifacts/release/provenance.slsa.md'
        }
      }
    }

    stage('Record Release Evidence') {
      steps {
        sh '''
          set -euo pipefail
          REGISTRY_HOST="${REGISTRY_HOST}" IMAGE_PREFIX="${IMAGE_PREFIX}" \
          SOURCE_IMAGE_TAG="${SOURCE_IMAGE_TAG}" TARGET_IMAGE_TAG="${TARGET_IMAGE_TAG}" \
          REPORT_DIR="${REPORT_DIR}" SBOM_DIR="${SBOM_DIR}" \
          DIGEST_RECORD_FILE="${REPORT_DIR}/promotion-digests.txt" \
          bash scripts/release/record-release-evidence.sh
        '''
      }
      post {
        always {
          archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/release/release-evidence.md,artifacts/release/release-manifest.env'
        }
      }
    }

    stage('Collect Supply Chain Evidence') {
      steps {
        sh '''
          set -euo pipefail
          REPORT_DIR="${REPORT_DIR}" SBOM_DIR="${SBOM_DIR}" \
          bash scripts/release/collect-supply-chain-evidence.sh
        '''
      }
      post {
        always {
          archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/release/supply-chain-evidence.md'
        }
      }
    }

    stage('Helm Security Scan') {
      steps {
        sh '''
          set -euo pipefail
          echo "[INFO] Running Checkov against Helm charts"
          checkov -d infra/helm/securerag/ --config-file security/checkov-config.yaml -o junitxml > artifacts/release/checkov-helm-cd.xml || true
        '''
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: 'artifacts/release/checkov-*.xml'
          archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/release/checkov-*.xml'
        }
      }
    }

    stage('Deploy to kind') {
      when {
        expression { return params.RUN_DEPLOY_KIND }
      }
      steps {
        withCredentials([
          file(credentialsId: 'cosign-public-key', variable: 'COSIGN_PUBLIC_KEY')
        ]) {
          sh '''
            set -euo pipefail
            REGISTRY_HOST="${REGISTRY_HOST}" IMAGE_PREFIX="${IMAGE_PREFIX}" IMAGE_TAG="${TARGET_IMAGE_TAG}" \
            REPORT_DIR="${REPORT_DIR}" IMAGE_DIGEST_FILE="${REPORT_DIR}/promotion-digests.txt" COSIGN_PUBLIC_KEY="${COSIGN_PUBLIC_KEY}" \
            RUN_POSTDEPLOY_VALIDATION="false" ENSURE_KIND_CLUSTER="true" REQUIRE_DIGEST_DEPLOY="true" \
            FORCE_WORKLOAD_ROLLOUT="true" STRICT_RUNTIME_IMAGE_PROOF="true" \
            DEPLOY_EVIDENCE_FILE="${REPORT_DIR}/no-rebuild-deploy-summary.md" \
            RUNTIME_IMAGE_PROOF_FILE="${REPORT_DIR}/runtime-image-rollout-proof.md" \
            bash scripts/deploy/verify-and-deploy-kind.sh
          '''
        }
      }
      post {
        failure {
          sh '''
            echo "[ROLLBACK] Deployment failed — initiating automatic rollback"
            NS="securerag-hub"
            for deploy in portal-web auth-users chatbot-manager conversation-service audit-security-service; do
              echo "[ROLLBACK] Rolling back deployment/${deploy}"
              kubectl rollout undo "deployment/${deploy}" -n "${NS}" 2>/dev/null || true
            done
            mkdir -p artifacts/validation
            {
              printf '# Rollback Evidence - SecureRAG Hub\n\n'
              printf -- '- Trigger: Deploy stage failure\n'
              printf -- '- Timestamp (UTC): `%s`\n\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
              printf '## Rolled-back deployments\n\n'
              for deploy in portal-web auth-users chatbot-manager conversation-service audit-security-service; do
                printf -- '- `%s`: rollback issued\n' "${deploy}"
              done
              printf '\n## Post-rollback state\n\n```text\n'
              kubectl get deploy -n "${NS}" -o wide 2>/dev/null || true
              printf '```\n'
            } > artifacts/validation/rollback-evidence.md
          '''
        }
        always {
          archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/release/no-rebuild-deploy-summary.md,artifacts/release/runtime-image-rollout-proof.*,artifacts/validation/rollback-evidence.md'
        }
      }
    }

    stage('Post-deploy Validation') {
      when {
        expression { return params.RUN_DEPLOY_KIND && params.RUN_POSTDEPLOY_VALIDATION }
      }
      steps {
        sh 'make post-deploy-validation'
      }
      post {
        failure {
          sh '''
            echo "[ROLLBACK] Post-deploy validation failed — initiating automatic rollback"
            NS="securerag-hub"
            for deploy in portal-web auth-users chatbot-manager conversation-service audit-security-service; do
              echo "[ROLLBACK] Rolling back deployment/${deploy}"
              kubectl rollout undo "deployment/${deploy}" -n "${NS}" 2>/dev/null || true
            done
            mkdir -p artifacts/validation
            {
              printf '# Rollback Evidence - SecureRAG Hub\n\n'
              printf -- '- Trigger: Post-deploy validation failure\n'
              printf -- '- Timestamp (UTC): `%s`\n\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
              printf '## Rolled-back deployments\n\n'
              for deploy in portal-web auth-users chatbot-manager conversation-service audit-security-service; do
                printf -- '- `%s`: rollback issued\n' "${deploy}"
              done
              printf '\n## Post-rollback state\n\n```text\n'
              kubectl get deploy -n "${NS}" -o wide 2>/dev/null || true
              printf '```\n'
            } > artifacts/validation/rollback-evidence.md
          '''
        }
        always {
          archiveArtifacts allowEmptyArchive: true, artifacts: 'reports/postdeploy/**,artifacts/validation/**'
        }
      }
    }

    stage('DAST — OWASP ZAP') {
      when {
        expression { return params.RUN_DAST }
      }
      steps {
        sh '''
          set -euo pipefail
          mkdir -p reports
          echo "[INFO] Running OWASP ZAP API scan against staging"
          docker run --rm --network host \
            -v "$(pwd)/reports:/zap/wrk:rw" \
            -e ZAP_FAIL_ON_RISK=High \
            ghcr.io/zaproxy/zaproxy:2.15.0@sha256:d8bd58f01b7a2d36ab2da5744275143a41b12658de3bb30eef794e77241cfd74 \
            zap-api-scan.py \
            -t http://staging.securerag.local/api/docs.json \
            -f openapi \
            -r zap-report.html \
            -J zap-report.json || true
          
          # Validation with the produced script
          bash scripts/zap-quality-gate.sh reports/zap-report.json
        '''
      }
      post {
        always {
          archiveArtifacts allowEmptyArchive: true, artifacts: 'reports/zap-report.html,reports/zap-report.json'
        }
      }
    }

    stage('Generate Support Pack') {
      steps {
        sh 'make support-pack'
      }
      post {
        always {
          archiveArtifacts allowEmptyArchive: true, artifacts: 'support-pack/**'
        }
      }
    }
  }

  post {
    success {
      echo 'SecureRAG Hub CD pipeline completed successfully.'
    }
    failure {
      echo 'SecureRAG Hub CD pipeline failed. Inspect release and deployment reports.'
      script {
        if (params.NOTIFICATION_EMAIL && params.NOTIFICATION_EMAIL.trim() != '') {
          def gitCommitShort = env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'N/A'
          def buildDuration = currentBuild.durationString ?: 'N/A'
          def buildUrl = env.BUILD_URL
          def consoleUrl = "${env.BUILD_URL}console"
          def jobName = env.JOB_NAME
          def buildNumber = env.BUILD_NUMBER
          def gitBranch = env.GIT_BRANCH ?: 'N/A'

          def htmlBody = """
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Build Failed</title>
  <style>
    @keyframes pulse {
      0% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
      }
      70% {
        transform: scale(1);
        box-shadow: 0 0 0 6px rgba(239, 68, 68, 0);
      }
      100% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
      }
    }
    body {
      background-color: #0f172a;
      color: #f8fafc;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }
    .container {
      max-width: 600px;
      margin: 40px auto;
      background-color: #0f172a;
      border: 1px solid #1e293b;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
    }
    .header {
      background: linear-gradient(135deg, #0f172a 0%, #450a0a 100%);
      padding: 35px 30px;
      text-align: center;
      position: relative;
      border-bottom: 2px solid #ef4444;
      box-shadow: inset 0 0 40px rgba(239, 68, 68, 0.15);
    }
    .badge-container {
      display: inline-block;
      margin-bottom: 12px;
    }
    .badge {
      background-color: #991b1b;
      color: #fca5a5;
      padding: 6px 14px;
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      display: inline-flex;
      align-items: center;
    }
    .dot {
      width: 8px;
      height: 8px;
      background-color: #ef4444;
      border-radius: 50%;
      margin-right: 8px;
      display: inline-block;
      animation: pulse 2s infinite;
    }
    .title {
      font-size: 24px;
      font-weight: 800;
      margin: 0;
      color: #ffffff;
      letter-spacing: -0.025em;
    }
    .content {
      padding: 30px;
    }
    .intro {
      font-size: 15px;
      color: #94a3b8;
      line-height: 1.6;
      margin-top: 0;
      margin-bottom: 24px;
    }
    .grid-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 8px;
      margin-bottom: 24px;
    }
    .card {
      background-color: #1e293b;
      border: 1px solid #334155;
      border-radius: 8px;
      padding: 12px 16px;
      width: 50%;
    }
    .card-label {
      font-size: 11px;
      color: #64748b;
      text-transform: uppercase;
      font-weight: 600;
      letter-spacing: 0.05em;
      margin-bottom: 4px;
    }
    .card-value {
      font-size: 14px;
      font-weight: 700;
      color: #e2e8f0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .card-value.highlight-red {
      color: #ef4444;
    }
    .card-value.highlight-blue {
      color: #3b82f6;
    }
    .section-title {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #475569;
      margin-bottom: 12px;
      border-bottom: 1px solid #1e293b;
      padding-bottom: 6px;
    }
    .tags-container {
      margin-bottom: 30px;
      line-height: 2.2;
    }
    .tag {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 600;
      margin-right: 6px;
    }
    .tag-sec {
      background-color: #172554;
      color: #93c5fd;
      border: 1px solid #1e3a8a;
    }
    .tag-scanner {
      background-color: #450a0a;
      color: #fca5a5;
      border: 1px solid #7f1d1d;
    }
    .tag-gate {
      background-color: #064e3b;
      color: #6ee7b7;
      border: 1px solid #065f46;
    }
    .tag-audit {
      background-color: #3b0764;
      color: #d8b4fe;
      border: 1px solid #581c87;
    }
    .actions {
      text-align: center;
      margin-bottom: 10px;
    }
    .btn {
      display: inline-block;
      padding: 12px 24px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      margin: 0 8px;
    }
    .btn-primary {
      background-color: #ef4444;
      color: #ffffff;
      border: 1px solid #ef4444;
    }
    .btn-secondary {
      background-color: transparent;
      color: #ffffff;
      border: 1px solid #475569;
    }
    .footer {
      background-color: #020617;
      padding: 24px;
      text-align: center;
      border-top: 1px solid #1e293b;
    }
    .footer-text {
      font-size: 12px;
      color: #64748b;
      margin: 0;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="badge-container">
        <span class="badge"><span class="dot"></span>Build Failed</span>
      </div>
      <h1 class="title">SecureRAG Hub — CD Alert</h1>
    </div>
    <div class="content">
      <p class="intro">Bonjour, le build de la pipeline de déploiement continu (CD) a échoué. Vous trouverez ci-dessous les détails du build ainsi que les outils de sécurité impliqués.</p>
      
      <table class="grid-table">
        <tr>
          <td class="card">
            <div class="card-label">Pipeline</div>
            <div class="card-value">${jobName}</div>
          </td>
          <td class="card">
            <div class="card-label">Build N°</div>
            <div class="card-value highlight-red">#${buildNumber}</div>
          </td>
        </tr>
        <tr>
          <td class="card">
            <div class="card-label">Branche Git</div>
            <div class="card-value highlight-blue">${gitBranch}</div>
          </td>
          <td class="card">
            <div class="card-label">Commit SHA</div>
            <div class="card-value">${gitCommitShort}</div>
          </td>
        </tr>
        <tr>
          <td class="card">
            <div class="card-label">Durée</div>
            <div class="card-value">${buildDuration}</div>
          </td>
          <td class="card">
            <div class="card-label">Environnement</div>
            <div class="card-value">DevSecOps CD</div>
          </td>
        </tr>
      </table>

      <div class="section-title">Outils de sécurité CD actifs</div>
      <div class="tags-container">
        <span class="tag tag-scanner">Trivy Image Scan</span>
        <span class="tag tag-sec">Cosign Signing</span>
        <span class="tag tag-sec">Cosign Verification</span>
        <span class="tag tag-scanner">Syft SBOM</span>
        <span class="tag tag-gate">Supply Chain Gate</span>
        <span class="tag tag-gate">Release Attestation</span>
        <span class="tag tag-gate">SLSA Provenance</span>
        <span class="tag tag-audit">OWASP ZAP DAST</span>
      </div>

      <div class="actions">
        <a href="${consoleUrl}" class="btn btn-primary">Voir la console</a>
        <a href="${buildUrl}" class="btn btn-secondary">Détails du build</a>
      </div>
    </div>
    <div class="footer">
      <p class="footer-text">SecureRAG Hub — Système d'Intégration et de Déploiement Continus</p>
    </div>
  </div>
</body>
</html>
"""

          mail to: params.NOTIFICATION_EMAIL,
               mimeType: 'text/html',
               subject: "🔴 [Jenkins] Échec du build : ${env.JOB_NAME} #${env.BUILD_NUMBER}",
               body: htmlBody
        }
      }
    }
    always {
      archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/sbom/**,artifacts/release/**,artifacts/validation/**,artifacts/support-pack/**'
    }
  }
}
