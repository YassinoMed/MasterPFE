// Jenkinsfile.cd — SecureRAG Hub CD (Deploy to Recette)
pipeline {
  agent none

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 60, unit: 'MINUTES')
  }

  parameters {
    string(name: 'RECETTE_HOST', defaultValue: '', description: 'IP/hostname recette (vide = via credential)')
    string(name: 'RECETTE_USER', defaultValue: 'deploy', description: 'SSH user')
    string(name: 'IMAGE_TAG', defaultValue: 'demo', description: 'Docker image tag à déployer')
    string(name: 'REGISTRY_HOST', defaultValue: 'localhost:5001', description: 'OCI registry')
    booleanParam(name: 'DEPLOY_TO_RECETTE', defaultValue: true, description: 'Deploy to recette')
    booleanParam(name: 'RUN_SMOKE_TESTS', defaultValue: true, description: 'Run smoke tests')
    booleanParam(name: 'RUN_CD_VALIDATION', defaultValue: true, description: 'Run post-deploy validation gates')
    booleanParam(name: 'RUN_SONAR', defaultValue: true, description: 'Run Sonar (post-deploy)')
    booleanParam(name: 'RUN_DAST', defaultValue: false, description: 'Run OWASP ZAP baseline')
    string(name: 'KUBE_SCORE_MAX_CRITICAL', defaultValue: '0', description: 'Max CRITICAL kube-score')
    string(name: 'KUBE_SCORE_MAX_WARNINGS', defaultValue: '0', description: 'Max WARNING kube-score')
    string(name: 'NOTIFICATION_EMAIL', defaultValue: '', description: 'Email de notification (vide = désactivé)')
  }

  environment {
    LARAVEL_SERVICES   = 'portal-web auth-users-service chatbot-manager-service conversation-service audit-security-service'
    SSH_KEY_CREDENTIAL = 'recette-deploy-ssh-key'
    SONAR_HOST_URL     = 'http://sonarqube.securerag-hub.svc:9000'
    DAST_PORTAL_URL    = 'http://staging.securerag.local:9081'
    REPORT_DIR         = 'security/reports'

    // Mapping sécurisé (prévention d'injection)
    ENV_RECETTE_HOST = "${params.RECETTE_HOST}"
    ENV_RECETTE_USER = "${params.RECETTE_USER}"
    ENV_IMAGE_TAG    = "${params.IMAGE_TAG}"
    ENV_REGISTRY_HOST = "${params.REGISTRY_HOST}"
    ENV_KUBE_SCORE_MAX_CRITICAL = "${params.KUBE_SCORE_MAX_CRITICAL}"
    ENV_KUBE_SCORE_MAX_WARNINGS = "${params.KUBE_SCORE_MAX_WARNINGS}"
  }

  stages {

    stage('Checkout') {
      agent { label 'built-in' }
      steps {
        timeout(time: 5, unit: 'MINUTES') {
          checkout scm
          sh '''
            set -euo pipefail
            # Validation stricte du tag d'image (anti-injection)
            echo "${ENV_IMAGE_TAG}" | grep -Eq '^[a-zA-Z0-9._-]+$' || { echo "[FATAL] IMAGE_TAG invalide"; exit 1; }
          '''
          stash name: 'workspace', includes: '**', excludes: '.git/**,**/vendor/**,**/node_modules/**'
        }
      }
    }

    stage('Prepare Workspace') {
      agent { label 'built-in' }
      steps {
        timeout(time: 3, unit: 'MINUTES') {
          unstash 'workspace'
          sh '''
            set -euo pipefail
            mkdir -p "${REPORT_DIR}" artifacts/security artifacts/dast
            find scripts -type f -name "*.sh" -exec chmod +x {} +
          '''
          stash name: 'workspace', includes: '**', excludes: '.git/**,**/vendor/**,**/node_modules/**'
        }
      }
    }

    // ════════════════════════════════════════════════════════════════
    //  PRE-DEPLOY GATES  (P1)
    //  CD_SECRETS_SCAN = BLOCKING. Les autres = ADVISORY (UNSTABLE).
    // ════════════════════════════════════════════════════════════════
    stage('CD_PRE_DEPLOY_GATES') {
      failFast false
      parallel {
        stage('CD_SECRETS_SCAN') {
          agent { label 'security-agent' }
          steps {
            timeout(time: 5, unit: 'MINUTES') {
              unstash 'workspace'
              sh '''
                set -euo pipefail
                mkdir -p "${REPORT_DIR}"
                gitleaks dir . --config .gitleaks.toml --report-format json --report-path "${REPORT_DIR}/cd-gitleaks.json" --verbose || true
                LEAKS=$(python3 -c "import json;d=json.load(open('${REPORT_DIR}/cd-gitleaks.json'));print(len(d) if isinstance(d,list) else 0)" 2>/dev/null || echo "0")
                if [ "${LEAKS}" -gt 0 ]; then
                  echo "==== BLOCKED: ${LEAKS} secret(s) detected! ===="
                  exit 1
                fi
                echo "[PASS] No secrets detected"
              '''
            }
          }
          post {
            failure { script { currentBuild.result = 'FAILURE' } }
            always { archiveArtifacts allowEmptyArchive: true, artifacts: 'security/reports/cd-gitleaks.json' }
          }
        }

        stage('CD_DOCKERFILE_LINT') {
          agent { label 'docker-agent' }
          steps {
            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
              timeout(time: 5, unit: 'MINUTES') {
                unstash 'workspace'
                sh 'bash scripts/ci/run-hadolint.sh'
              }
            }
          }
          post {
            always {
              junit allowEmptyResults: true, testResults: 'security/reports/hadolint-junit.xml'
              archiveArtifacts allowEmptyArchive: true, artifacts: 'security/reports/hadolint-junit.xml'
            }
          }
        }

        stage('CD_IAC_SCAN') {
          agent { label 'k8s-agent' }
          steps {
            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
              timeout(time: 10, unit: 'MINUTES') {
                unstash 'workspace'
                sh '''
                  set -euo pipefail
                  mkdir -p "${REPORT_DIR}"
                  set +e
                  checkov -d . --config-file security/checkov-config.yaml --skip-path vendor --skip-path node_modules \
                    --hard-fail-on HIGH -o json > "${REPORT_DIR}/cd-checkov-k8s.json" 2>/dev/null
                  rc=$?
                  set -e
                  [ $rc -ne 0 ] && { echo "[ERROR] Checkov found violations."; exit 1; } || true
                '''
              }
            }
          }
          post {
            always { archiveArtifacts allowEmptyArchive: true, artifacts: 'security/reports/cd-checkov-*.json' }
          }
        }

        stage('CD_MANIFEST_VALIDATE') {
          agent { label 'k8s-agent' }
          steps {
            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
              timeout(time: 10, unit: 'MINUTES') {
                unstash 'workspace'
                sh '''
                  set -euo pipefail
                  mkdir -p artifacts/security
                  KUSTOMIZE_OVERLAY=infra/k8s/overlays/recette STRICT_KUBE_SCORE=true \
                    KUBE_SCORE_MAX_CRITICAL="${ENV_KUBE_SCORE_MAX_CRITICAL:-0}" \
                    KUBE_SCORE_MAX_WARNINGS="${ENV_KUBE_SCORE_MAX_WARNINGS:-0}" \
                    bash scripts/ci/validate-kube-score.sh
                  REQUIRE_KYVERNO_CLI=true bash scripts/ci/validate-kyverno-policies.sh --dry-run
                '''
              }
            }
          }
          post {
            always { archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/security/kube-score-*,artifacts/security/*.md' }
          }
        }
      }
    }

    // ════════════════════════════════════════════════════════════════
    //  DEPLOY TO RECETTE
    // ════════════════════════════════════════════════════════════════
    stage('Deploy to Recette') {
      when { expression { return params.DEPLOY_TO_RECETTE } }
      agent { label 'deploy-agent' }
      steps {
        timeout(time: 30, unit: 'MINUTES') {
          unstash 'workspace'
          withCredentials([
            sshUserPrivateKey(credentialsId: "${SSH_KEY_CREDENTIAL}", keyFileVariable: 'DEPLOY_KEY'),
            file(credentialsId: 'recette-known-hosts', variable: 'KNOWN_HOSTS')
          ]) {
            sh '''
              set -euo pipefail
              echo "[INFO] Deploying to recette (${ENV_RECETTE_USER}@${ENV_RECETTE_HOST})..."

              # Host key vérifié (pas de StrictHostKeyChecking=no)
              SSH_OPTS="-i ${DEPLOY_KEY} -o UserKnownHostsFile=${KNOWN_HOSTS} -o StrictHostKeyChecking=yes -o ConnectTimeout=30"

              # Variables passées de façon SÛRE via heredoc QUOTÉ + préfixe d'env distant
              ssh ${SSH_OPTS} "${ENV_RECETTE_USER}@${ENV_RECETTE_HOST}" \
                IMAGE_TAG="${ENV_IMAGE_TAG}" REGISTRY_HOST="${ENV_REGISTRY_HOST}" bash -s <<'REMOTE_DEPLOY'
                set -euo pipefail
                APP_DIR="/opt/securerag"
                REPO_URL="https://github.com/YassinoMed/MasterPFE.git"

                command -v git >/dev/null 2>&1 || { sudo apt-get update && sudo apt-get install -y git ca-certificates; }

                if [ -d "${APP_DIR}/.git" ]; then
                  cd "${APP_DIR}"
                  git fetch origin main
                  git reset --hard origin/main
                else
                  git clone --branch main "${REPO_URL}" "${APP_DIR}"
                  cd "${APP_DIR}"
                fi
                echo "[RECETTE] HEAD: $(git log -1 --oneline)"

                bash scripts/deploy/create-kind.sh
                bash scripts/secrets/bootstrap-local-secrets.sh
                bash scripts/secrets/create-dev-secrets.sh

                REGISTRY_HOST="${REGISTRY_HOST}" IMAGE_PREFIX="securerag-hub" IMAGE_TAG="${IMAGE_TAG}" \
                  bash scripts/deploy/build-local-images.sh

                bash scripts/deploy/install-kyverno.sh

                REGISTRY_HOST="${REGISTRY_HOST}" IMAGE_PREFIX="securerag-hub" IMAGE_TAG="${IMAGE_TAG}" \
                  KUSTOMIZE_OVERLAY="infra/k8s/overlays/recette" bash scripts/deploy/deploy-kind.sh

                # Rollout déterministe (au lieu de delete pod --all)
                for d in portal-web auth-users-service chatbot-manager-service conversation-service audit-security-service; do
                  kubectl rollout restart "deployment/${d}" -n securerag-hub 2>/dev/null || true
                done
                for d in portal-web auth-users-service chatbot-manager-service conversation-service audit-security-service; do
                  kubectl rollout status "deployment/${d}" -n securerag-hub --timeout=300s
                done
                kubectl get all -n securerag-hub
REMOTE_DEPLOY

              echo "[INFO] Deployment to recette completed"
            '''
          }
        }
      }
      post {
        failure { echo '❌ Deploy to recette failed. Check SSH connectivity & remote logs.' }
        always  { archiveArtifacts allowEmptyArchive: true, artifacts: 'reports/deploy/*.log,reports/deploy/*.md' }
      }
    }

    stage('Post-deploy Smoke Tests') {
      when { expression { return params.DEPLOY_TO_RECETTE && params.RUN_SMOKE_TESTS } }
      agent { label 'deploy-agent' }
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          unstash 'workspace'   // FIX: workspace nécessaire pour les scripts
          withCredentials([
            sshUserPrivateKey(credentialsId: "${SSH_KEY_CREDENTIAL}", keyFileVariable: 'DEPLOY_KEY'),
            file(credentialsId: 'recette-known-hosts', variable: 'KNOWN_HOSTS')
          ]) {
            sh '''
              set -euo pipefail
              SSH_OPTS="-i ${DEPLOY_KEY} -o UserKnownHostsFile=${KNOWN_HOSTS} -o StrictHostKeyChecking=yes -o ConnectTimeout=30"
              ssh ${SSH_OPTS} "${ENV_RECETTE_USER}@${ENV_RECETTE_HOST}" bash -s <<'REMOTE_SMOKE'
                set -euo pipefail
                cd /opt/securerag
                bash scripts/deploy/smoke-test.sh
REMOTE_SMOKE
            '''
          }
        }
      }
      post {
        always { archiveArtifacts allowEmptyArchive: true, artifacts: 'reports/postdeploy/smoke-tests-report.md' }
      }
    }

    // ════════════════════════════════════════════════════════════════
    //  POST-DEPLOY VALIDATION  (P2 — ADVISORY)
    // ════════════════════════════════════════════════════════════════
    stage('CD_POST_DEPLOY_VALIDATION') {
      when { expression { return params.RUN_CD_VALIDATION } }   // FIX: param maintenant câblé
      parallel {
        stage('CD_SONARQUBE') {
          when { expression { return params.RUN_SONAR } }
          agent { label 'sonar-agent' }
          steps {
            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
              timeout(time: 10, unit: 'MINUTES') {
                unstash 'workspace'
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                  sh '''
                    set -euo pipefail
                    REQUIRE_SONAR=true SONAR_HOST_URL="${SONAR_HOST_URL}" SONAR_TOKEN="${SONAR_TOKEN}" \
                      bash scripts/ci/run-sonar-analysis.sh
                  '''
                }
              }
            }
          }
          post { always { archiveArtifacts allowEmptyArchive: true, artifacts: '.scannerwork/report-task.txt' } }
        }

        stage('CD_SUPPLY_CHAIN') {
          agent { label 'worker' }
          steps {
            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
              timeout(time: 10, unit: 'MINUTES') {
                unstash 'workspace'   // FIX: workspace
                sh '''
                  set -euo pipefail
                  set +e
                  rc1=0; rc2=0
                  if [ -f scripts/supply-chain/verify-slsa.sh ]; then
                    bash scripts/supply-chain/verify-slsa.sh; rc1=$?
                  else
                    echo "[WARN] SLSA verify script not found"
                  fi

                  COSIGN_PUB_KEY="k8s://securerag-hub/cosign-public-key"
                  if kubectl get secret cosign-public-key -n securerag-hub &>/dev/null; then
                    # FIX: vérifie TOUS les services, pas seulement portal-web
                    for svc in portal-web auth-users-service chatbot-manager-service conversation-service audit-security-service; do
                      echo "[INFO] cosign verify: ${svc}"
                      cosign verify --key "${COSIGN_PUB_KEY}" \
                        "${ENV_REGISTRY_HOST}/securerag-hub-${svc}:${ENV_IMAGE_TAG}" || rc2=1
                    done
                  else
                    echo "[WARN] Cosign public key not found — skipping image verification"
                  fi
                  set -e
                  [ $rc1 -ne 0 ] || [ $rc2 -ne 0 ] && { echo "[ERROR] Supply chain verification failed."; exit 1; } || true
                '''
              }
            }
          }
          post { always { archiveArtifacts allowEmptyArchive: true, artifacts: 'security/reports/slsa-verify*.json' } }
        }

        stage('CD_RUNTIME_SECURITY') {
          agent { label 'k8s-agent' }
          steps {
            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
              timeout(time: 5, unit: 'MINUTES') {
                unstash 'workspace'   // FIX: workspace
                sh '''
                  set -euo pipefail
                  set +e; rc1=0; rc2=0
                  [ -f scripts/ci/validate-tetragon-policies.sh ] && { bash scripts/ci/validate-tetragon-policies.sh; rc1=$?; }
                  [ -f scripts/ci/validate-opa-gatekeeper.sh ] && { bash scripts/ci/validate-opa-gatekeeper.sh; rc2=$?; }
                  set -e
                  [ $rc1 -ne 0 ] || [ $rc2 -ne 0 ] && { echo "[ERROR] Runtime security failed."; exit 1; } || true
                '''
              }
            }
          }
          post { always { archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/security/opa-audit*.json,artifacts/security/tetragon*.json' } }
        }

        stage('CD_SPIRE_VALIDATE') {
          agent { label 'worker' }
          steps {
            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
              timeout(time: 5, unit: 'MINUTES') {
                unstash 'workspace'   // FIX: workspace
                sh '''
                  set -euo pipefail
                  [ -f scripts/spire/deploy-spire.sh ] && bash scripts/spire/deploy-spire.sh --validate-only || echo "[WARN] SPIRE script not found"
                '''
              }
            }
          }
          post { always { archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/security/spire-validate*.json' } }
        }

        stage('CD_VAULT_SECRETS') {
          agent { label 'worker' }
          steps {
            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
              timeout(time: 5, unit: 'MINUTES') {
                unstash 'workspace'   // FIX: workspace
                sh '''
                  set -euo pipefail
                  [ -f scripts/vault/validate-dynamic-secrets.sh ] && bash scripts/vault/validate-dynamic-secrets.sh || echo "[WARN] Vault script not found"
                '''
              }
            }
          }
          post { always { archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/security/vault-validate*.json' } }
        }
      }
    }

    // ════════════════════════════════════════════════════════════════
    //  DAST — OWASP ZAP (ADVISORY)
    // ════════════════════════════════════════════════════════════════
    stage('DAST') {
      when { expression { return params.RUN_DAST } }
      agent { label 'docker-agent' }
      steps {
        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
          timeout(time: 15, unit: 'MINUTES') {
            unstash 'workspace'   // FIX: workspace
            sh '''
              set -euo pipefail
              mkdir -p artifacts/dast
              echo "[INFO] OWASP ZAP baseline vs ${DAST_PORTAL_URL}..."
              set +e
              docker run --rm -v "$(pwd)/artifacts/dast:/zap/wrk:rw" \
                -t ghcr.io/zaproxy/zaproxy:2.15.0 zap-baseline.py \
                -t "${DAST_PORTAL_URL}" -r dast-baseline-report.html -J dast-baseline-report.json -l WARN
              rc1=$?
              DAST_REPORT=artifacts/dast/dast-baseline-report.json DAST_FAIL_ON=High \
                bash scripts/validate/validate-dast-report.sh; rc2=$?
              set -e
              [ $rc1 -ne 0 ] || [ $rc2 -ne 0 ] && { echo "[ERROR] ZAP scan/validation failed."; exit 1; } || true
            '''
          }
        }
      }
      post {
        always {
          publishHTML(target: [allowMissing: true, alwaysLinkToLastBuild: true, keepAll: true,
            reportDir: 'artifacts/dast', reportFiles: 'dast-baseline-report.html', reportName: 'OWASP ZAP Baseline'])
          archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/dast/*'
        }
      }
    }
  }

  post {
    success { echo '✅ SecureRAG Hub CD — SUCCESS' }
    failure {
      echo '❌ SecureRAG Hub CD — FAILED'
      script {
        if (params.NOTIFICATION_EMAIL?.trim()) {
          mail to: params.NOTIFICATION_EMAIL,
               mimeType: 'text/html',
               subject: "🔴 [Jenkins] Échec CD : ${env.JOB_NAME} #${env.BUILD_NUMBER}",
               body: """<h2>SecureRAG Hub — CD Failed</h2>
                        <p>Pipeline: ${env.JOB_NAME} #${env.BUILD_NUMBER}</p>
                        <p>Branche: ${env.GIT_BRANCH ?: 'N/A'} | Commit: ${env.GIT_COMMIT?.take(7) ?: 'N/A'}</p>
                        <p><a href="${env.BUILD_URL}console">Voir la console</a></p>"""
        }
      }
    }
  }
}