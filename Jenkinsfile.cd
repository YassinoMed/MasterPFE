pipeline {
  agent {
    kubernetes {
      yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins
  containers:
  - name: tools
    image: mohamedyassinebouneb/securerag-hub-unified:latest
    imagePullPolicy: Always
    command:
    - cat
    tty: true
    env:
    - name: DOCKER_HOST
      value: tcp://localhost:2375
    volumeMounts:
    - name: composer-cache
      mountPath: /home/jenkins/.composer/cache
    - name: npm-cache
      mountPath: /home/jenkins/.npm
    - name: pip-cache
      mountPath: /home/jenkins/.cache/pip
    - name: trivy-cache
      mountPath: /home/jenkins/.trivycache
    - name: semgrep-cache
      mountPath: /home/jenkins/.semgrep
    - name: sonar-cache
      mountPath: /home/jenkins/.sonar
    - name: maven-cache
      mountPath: /home/jenkins/.m2
  - name: dind
    image: docker:27-dind
    securityContext:
      privileged: true
    env:
    - name: DOCKER_TLS_CERTDIR
      value: ""
  volumes:
  - name: composer-cache
    hostPath:
      path: /var/cache/jenkins/composer-cache-pvc
  - name: npm-cache
    hostPath:
      path: /var/cache/jenkins/npm-cache-pvc
  - name: pip-cache
    hostPath:
      path: /var/cache/jenkins/pip-cache
  - name: trivy-cache
    hostPath:
      path: /var/cache/jenkins/trivy-cache-pvc
  - name: semgrep-cache
    hostPath:
      path: /var/cache/jenkins/semgrep-cache
  - name: sonar-cache
    hostPath:
      path: /var/cache/jenkins/sonar-cache-pvc
  - name: maven-cache
    hostPath:
      path: /var/cache/jenkins/maven-cache
'''
      defaultContainer 'tools'
    }
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 90, unit: 'MINUTES')
    ansiColor('xterm')
    skipDefaultCheckout()
  }

  parameters {
    string(name: 'REGISTRY_HOST', defaultValue: 'localhost:5001', description: 'Target OCI registry')
    string(name: 'IMAGE_PREFIX', defaultValue: 'securerag-hub', description: 'OCI image prefix')
    string(name: 'SOURCE_IMAGE_TAG', defaultValue: 'dev', description: 'Release candidate tag')
    string(name: 'TARGET_IMAGE_TAG', defaultValue: 'release-local', description: 'Promoted image tag')
    booleanParam(name: 'SIGN_RELEASE_CANDIDATES', defaultValue: true, description: 'Cosign sign')
    booleanParam(name: 'RUN_GITOPS_SYNC', defaultValue: true, description: 'Update Git manifests')
    booleanParam(name: 'RUN_DAST', defaultValue: false, description: 'OWASP ZAP (Offloaded to weekly scheduler)')
    booleanParam(name: 'DEPLOY_TO_PRODUCTION', defaultValue: false, description: 'Trigger ArgoCD deploy')
    string(
      name: 'NOTIFICATION_EMAIL',
      defaultValue: 'med.yassine.bouneb@proton.me',
      description: 'Email address to notify on build failures. Leave empty to disable.'
    )
  }

  environment {
    SBOM_DIR = 'artifacts/sbom'
    REPORT_DIR = 'artifacts/release'

    // Cache configurations
    COMPOSER_HOME       = '/home/jenkins/.composer'
    COMPOSER_CACHE_DIR  = '/home/jenkins/.composer/cache'
    npm_config_cache    = '/home/jenkins/.npm'
    NPM_CONFIG_CACHE    = '/home/jenkins/.npm'
    PIP_CACHE_DIR       = '/home/jenkins/.cache/pip'
    TRIVY_CACHE_DIR     = '/home/jenkins/.trivycache'
    SEMGREP_CACHE_DIR   = '/home/jenkins/.semgrep'
    SONAR_USER_HOME     = '/home/jenkins/.sonar'
    KUBECONFIG          = ''
  }

  stages {

    stage('Prepare Workspace') {
      steps {
        retry(3) {
          timeout(time: 5, unit: 'MINUTES') {
            checkout scm
          }
        }
        sh 'mkdir -p "${SBOM_DIR}" "${REPORT_DIR}" artifacts/validation && find scripts -type f -name "*.sh" -exec chmod +x {} + || true'
        stash name: 'workspace', excludes: '.git/**, .trivycache/**, .semgrep/**, .sonar/**'
      }
    }

    stage('CD: Scans') {
      parallel {
        stage('Trivy Image Scan') {
          steps {
            timeout(time: 20, unit: 'MINUTES') {
              unstash 'workspace'
              sh '''
                REGISTRY_HOST="${REGISTRY_HOST}" IMAGE_PREFIX="${IMAGE_PREFIX}" IMAGE_TAG="${SOURCE_IMAGE_TAG}" \
                REPORT_DIR="${REPORT_DIR}" IMAGE_SCAN_DIR="security/reports" \
                bash scripts/release/scan-images.sh
              '''
              stash name: 'image-scan', includes: 'artifacts/release/*scan*,security/reports/trivy-image-*.json'
            }
          }
        }
        stage('Checkov Helm') {
          steps {
            timeout(time: 5, unit: 'MINUTES') {
              unstash 'workspace'
              sh 'checkov -d infra/helm/ --config-file security/checkov-config.yaml --hard-fail-on CRITICAL --soft-fail-on HIGH -o junitxml > artifacts/release/checkov-helm-cd.xml'
              stash name: 'checkov-cd', includes: 'artifacts/release/checkov-*.xml'
            }
          }
        }
      }
    }

    stage('CD: Supply Chain') {
      parallel {
        stage('Cosign Sign') {
          when { expression { return params.SIGN_RELEASE_CANDIDATES } }
          steps {
            timeout(time: 15, unit: 'MINUTES') {
              unstash 'workspace'
              sh '''
                REGISTRY_HOST="${REGISTRY_HOST}" IMAGE_PREFIX="${IMAGE_PREFIX}" IMAGE_TAG="${SOURCE_IMAGE_TAG}" \
                REPORT_DIR="${REPORT_DIR}" FAIL_FAST=true bash scripts/release/sign-images.sh
              '''
              stash name: 'sign-artifacts', includes: 'artifacts/release/*sign*'
            }
          }
        }
        stage('Generate SBOM + Grype') {
          steps {
            timeout(time: 15, unit: 'MINUTES') {
              unstash 'workspace'
              sh '''
                REGISTRY_HOST="${REGISTRY_HOST}" IMAGE_PREFIX="${IMAGE_PREFIX}" IMAGE_TAG="${TARGET_IMAGE_TAG}" \
                SBOM_DIR="${SBOM_DIR}" REPORT_DIR="${REPORT_DIR}" bash scripts/release/generate-sbom.sh
                STRICT_SBOM_VALIDATION=true SBOM_DIR="${SBOM_DIR}" REPORT_DIR="${REPORT_DIR}" bash scripts/release/validate-sbom-cyclonedx.sh
                for sbom in "${SBOM_DIR}"/*.cyclonedx.json; do
                  [ -e "$sbom" ] && grype "sbom:$sbom" --fail-on high,critical -o json > "${sbom}.grype.json"
                done
                python3 scripts/release/generate-vex.py \
                  --sbom-dir "${SBOM_DIR}" \
                  --context  "securerag-hub" \
                  --output   "${SBOM_DIR}/securerag-hub.vex.json"
              '''
              stash name: 'sbom-artifacts', includes: 'artifacts/sbom/**,artifacts/release/*sbom*'
            }
          }
        }
      }
    }

    stage('Cosign Verify') {
      when { expression { return params.SIGN_RELEASE_CANDIDATES } }
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          unstash 'workspace'
          sh '''
            REGISTRY_HOST="${REGISTRY_HOST}" IMAGE_PREFIX="${IMAGE_PREFIX}" IMAGE_TAG="${SOURCE_IMAGE_TAG}" \
            REPORT_DIR="${REPORT_DIR}" FAIL_FAST=true bash scripts/release/verify-signatures.sh
          '''
          stash name: 'verify-artifacts', includes: 'artifacts/release/*verify*'
        }
      }
    }

    stage('CD: SLSA Provenance') {
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          unstash 'workspace'
          sh '''
            REGISTRY_HOST="${REGISTRY_HOST}" IMAGE_PREFIX="${IMAGE_PREFIX}" \
            SOURCE_IMAGE_TAG="${SOURCE_IMAGE_TAG}" TARGET_IMAGE_TAG="${TARGET_IMAGE_TAG}" \
            REPORT_DIR="${REPORT_DIR}" bash scripts/supply-chain/build-provenance.sh
          '''
          stash name: 'provenance-artifacts', includes: 'artifacts/release/*provenance*,artifacts/release/*attestation*'
        }
      }
    }

    stage('CD: Heremetic Build') {
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          unstash 'workspace'
          sh '''
            REGISTRY_HOST="${REGISTRY_HOST}" IMAGE_PREFIX="${IMAGE_PREFIX}" \
            SOURCE_IMAGE_TAG="${SOURCE_IMAGE_TAG}" TARGET_IMAGE_TAG="${TARGET_IMAGE_TAG}" \
            bash scripts/supply-chain/hermetic-build.sh
          '''
          stash name: 'hermetic-artifacts', includes: 'artifacts/release/*hermetic*'
        }
      }
    }

    stage('CD: Promote by Digest') {
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          unstash 'workspace'
          sh '''
            REGISTRY_HOST="${REGISTRY_HOST}" IMAGE_PREFIX="${IMAGE_PREFIX}" \
            SOURCE_IMAGE_TAG="${SOURCE_IMAGE_TAG}" TARGET_IMAGE_TAG="${TARGET_IMAGE_TAG}" \
            REPORT_DIR="${REPORT_DIR}" VERIFY_SOURCE_BEFORE_PROMOTION=false VERIFY_TARGET_AFTER_PROMOTION=true \
            bash scripts/release/promote-by-digest.sh
          '''
          stash name: 'promote-artifacts', includes: 'artifacts/release/*promot*,artifacts/release/*digest*'
        }
      }
    }

    stage('CD: Release Evidence') {
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          unstash 'workspace'
          unstash 'sign-artifacts'
          unstash 'sbom-artifacts'
          unstash 'promote-artifacts'
          sh '''
            REPORT_DIR="${REPORT_DIR}" SBOM_DIR="${SBOM_DIR}" \
            DIGEST_RECORD_FILE="${REPORT_DIR}/promotion-digests.txt" \
            STRICT_RELEASE_ATTESTATION=true bash scripts/release/generate-release-attestation.sh
            REPORT_DIR="${REPORT_DIR}" DIGEST_RECORD_FILE="${REPORT_DIR}/promotion-digests.txt" \
            STRICT_PROVENANCE=true bash scripts/release/generate-provenance-statement.sh
            bash scripts/release/record-release-evidence.sh
          '''
        }
      }
    }

    stage('CD: GitOps Update') {
      when { expression { return params.RUN_GITOPS_SYNC } }
      steps {
        timeout(time: 5, unit: 'MINUTES') {
          unstash 'workspace'
          unstash 'promote-artifacts'
          sh '''
            DIGEST_RECORD_FILE="${REPORT_DIR}/promotion-digests.txt"
            if [ -f "$DIGEST_RECORD_FILE" ]; then
              git config --global user.email "jenkins@securerag.local"
              git config --global user.name "Jenkins GitOps Bot"
               while IFS="|" read -r service _ _ digest; do
                 case "$service" in "#"*) continue ;; esac
                 [ -n "$service" ] && [ -n "$digest" ] && bash scripts/gitops/update-image-digest.sh production "$service" "$digest"
               done < "$DIGEST_RECORD_FILE"
            fi
          '''
        }
      }
    }

    stage('CD_PRE_DEPLOY_GATES') {
      parallel {
        stage('AI_IMAGE_AUDITOR') {
          steps {
            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
              timeout(time: 10, unit: 'MINUTES') {
                unstash 'workspace'
                try { unstash 'image-scan' } catch(e) { echo "No image-scan stash" }
                try { unstash 'sbom-artifacts' } catch(e) { echo "No sbom-artifacts stash" }
                sh '''
                  set -euo pipefail
                  python3 scripts/ai/analyze-images.py \
                    --trivy-reports "security/reports/trivy-image-*.json" \
                    --sbom-dir      "${SBOM_DIR}" \
                    --registry      "${REGISTRY_HOST}" \
                    --image-prefix  "${IMAGE_PREFIX}" \
                    --image-tag     "${SOURCE_IMAGE_TAG}" \
                    --output        "artifacts/release/ai-image-advisory.md" \
                    --context       "SecureRAG Hub — auth, chatbot, conversation, audit, portal" \
                    --model         "claude-sonnet-4-6" || true
                '''
              }
            }
          }
          post {
            always {
              archiveArtifacts allowEmptyArchive: true,
                artifacts: 'artifacts/release/ai-image-advisory.md'
            }
          }
        }
      }
    }

    stage('CD: Deploy to Production') {
      when { expression { return params.DEPLOY_TO_PRODUCTION && params.RUN_GITOPS_SYNC } }
      steps {
        timeout(time: 15, unit: 'MINUTES') {
          unstash 'workspace'
          sh '''
            sleep 10
            echo "[INFO] Triggering ArgoCD sync and waiting..."
            export KUBECONFIG=""
            if command -v argocd &>/dev/null; then
              argocd app sync securerag-production --prune --timeout 300
              argocd app wait securerag-production --timeout 300
            else
              kubectl annotate application securerag-production -n argocd argocd.argoproj.io/refresh=normal --overwrite 2>/dev/null || true
            fi
            
            for deploy in portal-web auth-users chatbot-manager conversation-service audit-security-service; do
              kubectl rollout status "deployment/${deploy}" -n securerag-hub --timeout=300s || exit 1
            done
            bash scripts/validate/validate-deployment-health.sh || {
              NAMESPACE=securerag-hub bash scripts/gitops/rollback-deployment.sh
              exit 1
            }
          '''
        }
      }
    }

    stage('CD: Immutable Backup Validation') {
      when { expression { return params.DEPLOY_TO_PRODUCTION } }
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          unstash 'workspace'
          sh 'bash scripts/dr/validate-immutable.sh'
        }
      }
    }

    stage('CD: Performance Validation') {
      when { expression { return params.DEPLOY_TO_PRODUCTION } }
      steps {
        timeout(time: 20, unit: 'MINUTES') {
          unstash 'workspace'
          sh '''
            set -euo pipefail
            echo "═══ PERFORMANCE VALIDATION — k6 Performance Tests ═══"
            echo "[INFO] Running smoke + load + stress tests..."
            K6_TESTS=smoke,load,stress SLO_STRICT=true \
              bash scripts/performance/k6-jenkins-stage.sh

            echo "[INFO] Evaluating Performance Quality Gates..."
            echo "[INFO]   p95 < 200ms | error < 1% | availability > 99%"
            bash scripts/performance/performance-quality-gate.sh
          '''
        }
      }
      post {
        always {
          archiveArtifacts allowEmptyArchive: true,
            artifacts: 'reports/k6/**'
          publishHTML(target: [
            allowMissing: true,
            alwaysLinkToLastBuild: true,
            keepAll: true,
            reportDir: 'reports/k6',
            reportFiles: '**/k6-report-*.html',
            reportName: 'k6 Performance Reports (CD)'
          ])
          archiveArtifacts allowEmptyArchive: true,
            artifacts: 'reports/k6/performance-gate-report.md,reports/k6/performance-gate-result.json'
        }
      }
    }

    stage('CD: Ratify Policy Sync') {
      when { expression { return params.DEPLOY_TO_PRODUCTION } }
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          unstash 'workspace'
          sh 'bash scripts/ratify/deploy-ratify.sh --verify-only'
        }
      }
    }

    stage('CD: DAST — OWASP ZAP') {
      when { expression { return params.RUN_DAST } }
      steps {
        timeout(time: 20, unit: 'MINUTES') {
          unstash 'workspace'
          sh '''
            mkdir -p reports
            zap-api-scan.py -t http://staging.securerag.local/api/docs.json -f openapi -r zap-report.html -J zap-report.json
            bash scripts/zap-quality-gate.sh reports/zap-report.json
          '''
        }
      }
      post {
        always { archiveArtifacts allowEmptyArchive: true, artifacts: 'reports/zap-*' }
      }
    }

    stage('CD: DR Test — Backup Validation') {
      when { expression { return params.DEPLOY_TO_PRODUCTION } }
      steps {
        timeout(time: 15, unit: 'MINUTES') {
          unstash 'workspace'
          sh '''
            set -euo pipefail
            echo "═══ DR TEST — BACKUP & RESTORE VALIDATION ═══"
            if command -v velero &>/dev/null || kubectl get deployment -n velero velero &>/dev/null 2>&1; then
              bash scripts/dr/backup-test.sh || echo "[WARN] Backup test had issues"
              bash scripts/dr/validate-restore.sh || echo "[WARN] Restore validation had issues"
            else
              echo "[WARN] Velero not installed — DR test skipped"
            fi
          '''
        }
      }
      post {
        always { archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/validation/restore-drill-*.md,artifacts/dr/*.md' }
      }
    }

    stage('Generate Support Pack') {
      steps {
        timeout(time: 5, unit: 'MINUTES') {
          unstash 'workspace'
          sh 'make support-pack'
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts allowEmptyArchive: true, artifacts: 'artifacts/sbom/**,artifacts/release/**,artifacts/validation/**'
      cleanWs deleteDirs: true, notFailBuild: true
    }
    success {
      script { sendNotifications('SUCCESS') }
    }
    failure {
      script { sendNotifications('FAILURE') }
    }
    unstable {
      script { sendNotifications('UNSTABLE') }
    }
    aborted {
      script { sendNotifications('ABORTED') }
    }
  }
}

def sendNotifications(String status) {
  def colorMap = [
    'SUCCESS': '#22c55e',
    'FAILURE': '#ef4444',
    'UNSTABLE': '#eab308',
    'ABORTED': '#64748b'
  ]
  def statusColor = colorMap[status] ?: '#64748b'
  def msg = "SecureRAG Hub CD Pipeline - ${env.JOB_NAME} #${env.BUILD_NUMBER} - ${status} (${env.BUILD_URL})"
  
  echo "Sending notifications for status: ${status}"
  
  // ── Slack ────────────────────────────────────────────────────────
  try {
    slackSend channel: '#securerag-alerts', color: statusColor, message: msg
  } catch (Exception e) {
    echo "[WARN] Slack notification failed/skipped: ${e.getMessage()}"
  }

  // ── Teams ────────────────────────────────────────────────────────
  try {
    if (env.TEAMS_WEBHOOK_URL) {
      sh "curl -s -X POST -H 'Content-Type: application/json' -d '{\"text\": \"${msg}\"}' \"\${TEAMS_WEBHOOK_URL}\" || true"
    }
  } catch (Exception e) {
    echo "[WARN] Teams notification failed/skipped: ${e.getMessage()}"
  }

  // ── Email ────────────────────────────────────────────────────────
  if (params.NOTIFICATION_EMAIL && params.NOTIFICATION_EMAIL.trim() != '') {
    try {
      def gitCommitShort = env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'N/A'
      def buildDuration = currentBuild.durationString ?: 'N/A'
      def buildUrl = env.BUILD_URL
      def consoleUrl = "${env.BUILD_URL}console"
      def jobName = env.JOB_NAME
      def buildNumber = env.BUILD_NUMBER
      def gitBranch = env.GIT_BRANCH ?: 'N/A'

      def htmlBody = """
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Build ${status}</title>
  <style>
    body {
      background-color: #0f172a;
      color: #f8fafc;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      margin: 0;
      padding: 0;
    }
    .container {
      max-width: 600px;
      margin: 40px auto;
      background-color: #0f172a;
      border: 1px solid #1e293b;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
    }
    .header {
      background: linear-gradient(135deg, #0f172a 0%, ${status == 'FAILURE' ? '#450a0a' : '#064e3b'} 100%);
      padding: 35px 30px;
      text-align: center;
      border-bottom: 2px solid ${statusColor};
    }
    .badge {
      background-color: ${statusColor};
      color: #ffffff;
      padding: 6px 14px;
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
    }
    .title {
      font-size: 24px;
      font-weight: 800;
      margin: 15px 0 0 0;
      color: #ffffff;
    }
    .content {
      padding: 30px;
    }
    .intro {
      font-size: 15px;
      color: #94a3b8;
      line-height: 1.6;
    }
    .grid-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 8px;
      margin-bottom: 24px;
    }
    .card {
      background-color: #1e293b;
      border: 1px solid #334155;
      border-radius: 8px;
      padding: 12px 16px;
    }
    .card-label {
      font-size: 11px;
      color: #64748b;
      text-transform: uppercase;
      font-weight: 600;
    }
    .card-value {
      font-size: 14px;
      font-weight: 700;
      color: #e2e8f0;
    }
    .actions {
      text-align: center;
    }
    .btn {
      display: inline-block;
      padding: 12px 24px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      background-color: ${statusColor};
      color: #ffffff;
    }
    .footer {
      background-color: #020617;
      padding: 24px;
      text-align: center;
      border-top: 1px solid #1e293b;
    }
    .footer-text {
      font-size: 12px;
      color: #64748b;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <span class="badge">Pipeline ${status}</span>
      <h1 class="title">SecureRAG Hub — CD Alert</h1>
    </div>
    <div class="content">
      <p class="intro">Bonjour, la pipeline de CD a fini avec le statut : <strong>${status}</strong>.</p>
      
      <table class="grid-table">
        <tr>
          <td class="card">
            <div class="card-label">Pipeline</div>
            <div class="card-value">${jobName}</div>
          </td>
          <td class="card">
            <div class="card-label">Build N°</div>
            <div class="card-value">#${buildNumber}</div>
          </td>
        </tr>
        <tr>
          <td class="card">
            <div class="card-label">Branche</div>
            <div class="card-value">release</div>
          </td>
          <td class="card">
            <div class="card-label">Commit SHA</div>
            <div class="card-value">${gitCommitShort}</div>
          </td>
        </tr>
        <tr>
          <td class="card">
            <div class="card-label">Durée</div>
            <div class="card-value">${buildDuration}</div>
          </td>
          <td class="card">
            <div class="card-label">Environnement</div>
            <div class="card-value">Production / Main</div>
          </td>
        </tr>
      </table>

      <div class="actions">
        <a href="${consoleUrl}" class="btn">Consulter la Console</a>
      </div>
    </div>
    <div class="footer">
      <p class="footer-text">SecureRAG Hub — Cloud Native DevSecOps Portal</p>
    </div>
  </div>
</body>
</html>
"""
      mail to: params.NOTIFICATION_EMAIL,
           mimeType: 'text/html',
           subject: "[Jenkins] ${status}: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
           body: htmlBody
    } catch (Exception e) {
      echo "[WARN] Email notification failed: ${e.getMessage()}"
    }
  }
}
